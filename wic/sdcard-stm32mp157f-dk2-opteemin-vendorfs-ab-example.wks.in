# short-description: Create SD card image with a boot partition (example of wic file for stm32mp board)
# long-description: Creates a partitioned SD card image (example of wic file for stm32mp board)
#
#  - ------- ------------- ------ ------ ------------ ---------- ---------- ---------- ---------- ---------- --------
# | | TFA(2)| Metadata(2) | FIPA | FIPB | U-BOOT ENV | bootfs-a | bootfs-b | vendorfs | rootfs-a | rootfs-b | userfs |
# | | 0.5MB |   0.5MB     |  4MB |  4MB |    0.5MB   |   64MB   |   64MB   |   16MB   |  1024MB  |  1024MB  |  256MB |
#  - ------- ------------- ------ ------ ------------ ---------- ---------- ---------- ---------- ---------- --------
# ^ ^       ^             ^      ^      ^            ^          ^          ^          ^          ^          ^        ^
# | |       |             |      |      |            |          |          |          |          |          |        |
# 0 |     529KB          1MB    5MB    9MB         9.5MB      73.5MB    137.5MB    153.5MB    1177.5MB   2201.5MB    |
#   |                                                                                                                |
# 17KiB                                                                                                           2457.5MB
#
# Warning: the first stage of boot (here fsbl1, fsbl2, metadata1, metadata2, fipa, fipb) MUST be on GPT partition to be detected.
#

# FSBL partitions aka TF-A BL2
part fsbl1 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fsbl1 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-stm32mp157f-dk2-opteemin-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K --align 17
part fsbl2 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fsbl2 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/tf-a-stm32mp157f-dk2-opteemin-sdcard.stm32" --ondisk mmcblk --part-type 0x8301 --fixed-size 256K

# Metadata partitions
part metadata1 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=metadata1 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/metadata-ab-sdcard.bin" --ondisk mmcblk --part-type ${DEVICE_TYPEUUID_FWU_MDATA} --fixed-size 256K
part metadata2 --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=metadata2 --sourceparams="file=${DEPLOY_DIR_IMAGE}/arm-trusted-firmware/metadata-ab-sdcard.bin" --ondisk mmcblk --part-type ${DEVICE_TYPEUUID_FWU_MDATA} --fixed-size 256K

# Fip partitions
part fip-a   --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fip-a --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip/fip-stm32mp157f-dk2-opteemin-sdcard.bin" --ondisk mmcblk --part-type 19d5df83-11b0-457b-be2c-7559c13142a5 --fixed-size 4096K --uuid 4fd84c93-54ef-463f-a7ef-ae25ff887087
part fip-b   --source rawcopy --fstype=ext4 --fsoptions "noauto" --part-name=fip-b --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip/fip-stm32mp157f-dk2-opteemin-sdcard.bin" --ondisk mmcblk --part-type 19d5df83-11b0-457b-be2c-7559c13142a5 --fixed-size 4096K --uuid 09c54952-d5bf-45af-acee-335303766fb3

# U-BOOT env
part u-boot-env --source empty --part-name=u-boot-env --ondisk mmcblk --part-type ${DEVICE_TYPEUUID_UBOOT_ENV} --fixed-size 512K

# Bootfs
part /boot   --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/boot --ondisk mmcblk --fstype=ext4 --label bootfs-a --active --fixed-size 64M --extra-space 0 --part-type ${DEVICE_TYPEUUID_BOOTFS} --uuid ${DEVICE_PARTUUID_BOOTFS_A:SDCARD}
part /boot --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/boot --ondisk mmcblk --fstype=ext4 --label bootfs-b --active --fixed-size 64M --extra-space 0 --part-type ${DEVICE_TYPEUUID_BOOTFS} --uuid ${DEVICE_PARTUUID_BOOTFS_B:SDCARD}

# vendorfs
part /vendor --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/vendor --ondisk mmcblk --fstype=ext4 --label vendorfs --active --align 4096 --fixed-size 16M --extra-space 0

# Rootfs
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs-a --extra-space 1024M --part-type ${DEVICE_TYPEUUID_ROOTFS} --uuid ${DEVICE_PARTUUID_ROOTFS_A:SDCARD}
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs-b --extra-space 1024M --part-type ${DEVICE_TYPEUUID_ROOTFS} --uuid ${DEVICE_PARTUUID_ROOTFS_B:SDCARD}

# Userfs
part /usr/local --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/usr/local --ondisk mmcblk --fstype=ext4 --label userfs --active --align 4096 --fixed-size 256M --extra-space 0

bootloader --ptable gpt
