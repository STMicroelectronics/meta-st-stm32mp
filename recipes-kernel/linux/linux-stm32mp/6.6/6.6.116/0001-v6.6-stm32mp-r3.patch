+static void dcmipp_statcap_release(struct video_device *vdev)
+{
+	struct dcmipp_statcap_device *vcap =
+		container_of(vdev, struct dcmipp_statcap_device, vdev);
+
+	dcmipp_pads_cleanup(vcap->ved.pads);
+	mutex_destroy(&vcap->lock);
+
+	kfree(vcap);
+}
