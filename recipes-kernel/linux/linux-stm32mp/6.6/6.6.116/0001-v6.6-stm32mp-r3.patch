+				action, signal_id);
+			return -EINVAL;
+		}
+		ccer_val = 0;
+		break;
+	case COUNTER_SYNAPSE_CAPTURE_RISING_EDGE:
+	case COUNTER_SYNAPSE_CAPTURE_FALLING_EDGE:
+	case COUNTER_SYNAPSE_CAPTURE_BOTH_EDGES:
