+static int stm32_cryp_align_sgs(struct scatterlist **sg, size_t *new_sg_len, int bs,
+				struct scatterlist *new_sg, int payload)
+{
+	int ret;
+
+	ret = stm32_cryp_copy_sgs(sg, new_sg, payload, bs);
+	if (ret)
+		return ret;
+
+	ret = sg_nents_for_len(new_sg, payload);
