+static void stm32_cryp_align_cleanup(struct scatterlist *sg, struct scatterlist *orig, int len)
+{
+	void *buf;
+	int pages;
+
+	buf = sg_virt(sg);
+	pages = get_order(len);
+
+	if (orig)
+		stm32_cryp_copy_data(sg, orig, 0, len);
+
+	free_pages((unsigned long)buf, pages);
+}
