+};
+
+&usbotg_hs {
+	role-switch-default-mode = "peripheral";
+	dr_mode = "peripheral";
+	usb-role-switch;
+	status = "okay";
+	port {
+		usb_c_device_port: endpoint {
+			remote-endpoint = <&usb_c_port>;
+		};
+	};
+};
