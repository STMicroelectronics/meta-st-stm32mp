+		.of_match_table = stm32mp25_match_data,
+		.pm = &stm32_rcc_pm_ops,
+	},
+	.probe = stm32mp25_rcc_clocks_probe,
+	.remove_new = stm32mp25_rcc_clock_remove,
+};
