+					 struct v4l2_format *f)
+{
+	struct v4l2_meta_format *meta = &f->fmt.meta;
+
+	meta->dataformat = V4L2_META_FMT_ST_DCMIPP_ISP_STAT;
+	meta->buffersize = sizeof(struct stm32_dcmipp_stat_buf);
