+	/* Wait for debounce time */
+	msleep(TDCD_DBNC);
+
+	reg_val = dwc2_readl(hsotg, GGPIO);
+	if (!(reg_val & GGPIO_STM32_OTG_GCCFG_FSVPLUS))
+		retval = 0;
+	else
+		retval = -EAGAIN;
