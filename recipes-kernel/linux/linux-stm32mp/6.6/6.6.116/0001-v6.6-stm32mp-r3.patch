+		if (cs >= STM32_OMI_MAX_NORCHIP) {
+			dev_err(ospi->dev, "invalid reg value: %d\n", cs);
+			of_node_put(child);
+			ret = -EINVAL;
+			goto err_pm_resume;
+		}
