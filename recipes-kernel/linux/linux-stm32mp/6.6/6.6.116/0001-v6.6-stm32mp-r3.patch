+	 * Just return default source index in this case, as it will be used by default if not
+	 * explicitly configured.
+	 */
+	if (*source)
+		(*source)--;
+
+	if (*source > TIM_CCMR_CC1S_TI2 - 1)
+		return -EINVAL;
+
+	return 0;
+}
