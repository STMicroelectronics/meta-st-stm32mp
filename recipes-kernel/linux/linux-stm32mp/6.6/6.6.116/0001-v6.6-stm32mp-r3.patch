+		unsigned int px_clock_hz, target_px_clock_min, target_px_clock_max;
+		int dsi_short_packet_size_px, hfp, hsync, hbp, delay_to_lp, ret;
+		struct dw_mipi_dsi_dphy_timing dphy_timing;
+
