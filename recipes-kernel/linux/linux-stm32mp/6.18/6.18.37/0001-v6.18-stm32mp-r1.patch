diff --git a/Documentation/devicetree/bindings/mailbox/mbox-cdev.yaml b/Documentation/devicetree/bindings/mailbox/mbox-cdev.yaml
new file mode 100644
index 000000000..a34d30fa0
--- /dev/null
+++ b/Documentation/devicetree/bindings/mailbox/mbox-cdev.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mailbox/mbox-cdev.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Mailbox Character Device
+
+description: |
+  This binding describes a mailbox character device that uses a mailbox
+  framework and a memory region to communicate with a remote processor.
+
+maintainers:
+  - Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
+
+properties:
+  compatible:
+    const: mbox-cdev
+
+  reg:
+    maxItems: 1
+
+  memory-region:
+    description: |
+      Phandle to the reserved memory region used for communication with the
+      coprocessor.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  mboxes:
+    description: |
+      phandles to the mailbox channel used for communication.
+    maxItems: 1
+
+  mbox-names:
+    items:
+      - const: rx-tx
+
+required:
+  - compatible
+  - reg
+  - memory-region
+  - mboxes
+
+additionalProperties: false
+
+examples:
+  - |
+    reserved-memory {
+      #address-cells = <1>;
+      #size-cells = <1>;
+      ranges;
+
+      memory_region: memory-region@20000000 {
+        reg = <0x20000000 0x10000>;
+        no-map;
+      };
+    };
+
+    mbox_client: mailbox-client@0 {
+      compatible = "mbox-cdev";
+      reg = <1 0>;
+      memory-region = <&memory_region>;
+      mboxes = <&mailbox0>;
+    };
