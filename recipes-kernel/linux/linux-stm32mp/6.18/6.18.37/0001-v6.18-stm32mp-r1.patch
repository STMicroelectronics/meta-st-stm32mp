+&i2c4_pins_a {
+	bootph-all;
+	pins {
+		bootph-all;
+	};
+};
+
+&ipcc {
+	status = "okay";
+};
+
+&iwdg1 {
+	timeout-sec = <32>;
+	bootph-all;
+	status = "okay";
