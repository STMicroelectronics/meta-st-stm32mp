+	reg_val = dwc2_readl(hsotg, GGPIO);
+	reg_val &= ~GGPIO_STM32_OTG_GCCFG_DCDEN;
+	dwc2_writel(hsotg, reg_val, GGPIO);
+
+	return retval;
+}
