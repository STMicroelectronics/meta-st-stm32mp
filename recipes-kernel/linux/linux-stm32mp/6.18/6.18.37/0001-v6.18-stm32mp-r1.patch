+static int stm32_rproc_enable_pm(struct rproc *rproc)
+{
+	struct stm32_rproc *ddata = rproc->priv;
+	struct device *dev = rproc->dev.parent;
+	int err;
+
+	err = pm_runtime_resume_and_get(dev);
+	if (err)
