+
+	rtc->clk_lsco_hw.init = &init;
+
+	ret = devm_clk_hw_register(dev, &rtc->clk_lsco_hw);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &rtc->clk_lsco_hw);
+}
