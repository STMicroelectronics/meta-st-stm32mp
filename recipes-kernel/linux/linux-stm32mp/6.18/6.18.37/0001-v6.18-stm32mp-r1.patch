new file mode 100644
index 000000000..92c95bd92
--- /dev/null
+++ b/arch/arm/boot/dts/st/stm32mp153-scmi.dtsi
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) STMicroelectronics 2026 - All Rights Reserved
+ * Author: Patrick Delaunay <patrick.delaunay@foss.st.com> for STMicroelectronics.
+ */
+
+#include "stm32mp151-scmi.dtsi"
+
+/ {
+	cpus {
+
+		cpu1: cpu@1 {
+			/delete-property/ clock-names;
+			/delete-property/ clocks;
+			/delete-property/ operating-points-v2;
+
+			enable-method = "psci";
+			power-domains = <&cpu0_pd>, <&scmi_perf 0>;
+			power-domain-names = "psci", "perf";
+		};
+	};
+
+	psci {
+		cpu1_pd: power-domain-cpu1 {
+			#power-domain-cells = <0>;
+			domain-idle-states = <&cpu_pwrdn>;
+			power-domains = <&pd_core>;
+		};
+	};
+};
+
+&m_can1 {
+	clocks = <&scmi_clk CK_SCMI_HSE>, <&rcc FDCAN_K>;
+	power-domains = <&d1_pd>;
+};
+
+&m_can2 {
+	clocks = <&scmi_clk CK_SCMI_HSE>, <&rcc FDCAN_K>;
+	power-domains = <&d1_pd>;
+};
+
+&optee {
+	interrupts = <GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_LOW)>;
+};
