+static void rcc_summary_show_one(struct seq_file *s, const char *name,
+				 unsigned long rate,
+				 bool is_enabled,
+				 int level)
+{
+	seq_printf(s, "%*s%-*s %11lu  %9c\n",
+		   level * 3 + 1, "",
+		   40 - level * 3,
+		   name,
+		   rate,
+		   is_enabled ? 'Y' : 'N'
