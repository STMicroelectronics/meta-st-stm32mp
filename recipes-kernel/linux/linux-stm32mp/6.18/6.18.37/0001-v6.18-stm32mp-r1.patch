+	ret = regmap_read_poll_timeout(common->regmap,
+				       common->dlyb_base + SYSCFG_DLYBOS_SR,
+				       sr, sr & DLYBOS_SR_LOCK, 1,
+				       1000 * STM32_DLYBOS_TIMEOUT_MS);
+	if (ret) {
+		dev_err(common->dev, "Delay Block lock timeout\n");
+		stm32_ospi_dlyb_stop(common);
