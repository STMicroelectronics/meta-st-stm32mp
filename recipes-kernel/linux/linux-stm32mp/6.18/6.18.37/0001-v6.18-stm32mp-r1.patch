+static const struct dcmipp_tpg_pix_map *dcmipp_tpg_pix_map_by_code(u32 code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(dcmipp_tpg_pix_map_list); i++) {
+		if (dcmipp_tpg_pix_map_list[i].code == code)
