+	if (ret) {
+		dev_err(dev, "Can't find reg property\n");
+		goto err_pm_disable;
+	}
+
+	ret = of_property_read_u32(flash, "st,max-frequency", &value);
+	if (ret) {
+		dev_err(dev, "Can't find st,max-frequency property\n");
+		goto err_pm_disable;
+	}
