+
+	parent_name = __clk_get_name(rtc->rtc_ck);
+
+	init.name = "rtc_lsco";
+	init.flags = flags;
+	init.ops = &stm32_rtc_clk_lsco_ops;
+	init.parent_names = &parent_name;
