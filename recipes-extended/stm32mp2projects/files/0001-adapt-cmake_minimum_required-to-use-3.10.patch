From 94cafa162ae653f45eafdf5d5355ecf0b25f7c0e Mon Sep 17 00:00:00 2001
From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Wed, 8 Oct 2025 09:49:10 +0200
Subject: [PATCH] adapt cmake_minimum_required to use 3.10

With cmake 4.1, version < 3.5 is no more supported

Signed-off-by: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
---
Upstream-Status: Pending

 Middlewares/Third_Party/OpenAMP/libmetal/CMakeLists.txt | 2 +-
 Middlewares/Third_Party/OpenAMP/open-amp/CMakeLists.txt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Middlewares/Third_Party/OpenAMP/libmetal/CMakeLists.txt b/Middlewares/Third_Party/OpenAMP/libmetal/CMakeLists.txt
index 7ea8f7b..7bca5da 100644
--- a/Middlewares/Third_Party/OpenAMP/libmetal/CMakeLists.txt
+++ b/Middlewares/Third_Party/OpenAMP/libmetal/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required (VERSION 3.0.2)
+cmake_minimum_required (VERSION 3.10)
 if (POLICY CMP0048)
   cmake_policy(SET CMP0048 NEW)
 endif()
diff --git a/Middlewares/Third_Party/OpenAMP/open-amp/CMakeLists.txt b/Middlewares/Third_Party/OpenAMP/open-amp/CMakeLists.txt
index e77351b..cc3e287 100644
--- a/Middlewares/Third_Party/OpenAMP/open-amp/CMakeLists.txt
+++ b/Middlewares/Third_Party/OpenAMP/open-amp/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required (VERSION 3.0.2)
+cmake_minimum_required (VERSION 3.10)
 if (POLICY CMP0048)
   cmake_policy(SET CMP0048 NEW)
 endif()
