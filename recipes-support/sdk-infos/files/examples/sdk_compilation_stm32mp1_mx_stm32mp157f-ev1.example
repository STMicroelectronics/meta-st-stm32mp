#!/bin/bash

##################################################################
##################################################################
### General configuration
##################################################################
##################################################################
# Path to SDK environment (where is 'environment-setup-cortexa7t2hf-neon-vfpv4-ostl-linux-gnueabi')
# Usually: /opt/st/stm32mp1/<X.X.X>-openstlinux-<X.X>-yocto-<version_name>-mpu-v<XX.XX.XX>
sdk_absolute_path="<SDK absolute path>"

# Name of environment setup script for sdk
sdk_env_file="environment-setup-cortexa7t2hf-neon-vfpv4-ostl-linux-gnueabi"

# Configuration for building stm32mp1x
your_board_name="stm32mp157f-ev1-mx"

# your_soc_name can be stm32mp15 or stm32mp13
your_soc_name="stm32mp15"

# Type of security can be 'optee' or 'opteemin' (opteemin is preconize for stm32mp15)
your_storage_boot_scheme_security="opteemin"

# Type of boot scheme storage used for Cortex A7 part, ex.:
#    optee-emmc
#    optee-sdcard
#    optee-nor
#    optee-nand
#    optee-spinand
#    opteemin-emmc
#    opteemin-sdcard
#    opteemin-nor
#    opteemin-nand
#    opteemin-spinand
your_storage_boot_scheme_cortex_a="opteemin-sdcard"

# Location to store all the binaries generated
your_deploy_dir_path="$PWD/output-sdk-stm32mp157f-ev1-mx"

# Define build subdirectory (by default set to ../build)
your_build_subdir_path="../build-stm32mp157f-ev1-mx"

# ----------------------------
# CUBE MX Project
# ----------------------------
# define the cube mx project name
# ex.: for <path>/CA7/DeviceTree/cube_mx_project/kernel/<cube mx dt>
#      your_cubemx_project_name=cube_mx_project
#      externaldt_path=path
your_cubemx_project_name=stm32mp157f-ev1-mx

# ----------------------------------------------------------------
# ----------------------------------------------------------------
### CubeMX DT configuration
# ----------------------------------------------------------------
# ----------------------------------------------------------------
# CubeMX devicetree tree
#  <CUBMEMX project path>/CA7/DeviceTree/<your_cubemx_project_name/
#    ├── kernel
#    ├── optee-os
#    ├── tf-a
#    └── u-boot

# ------------------------------
# Via CubeMX dt
# force external dt path to CubeMX project path
# ex.: externaldt_path=my_project_path
externaldt_path=<CubeMX_path>

# external dt subpath for Optee
externaldt_optee_path=CA7/DeviceTree/${your_cubemx_project_name}/optee-os
externaldt_optee_programmer_path=CA7/DeviceTree/${your_cubemx_project_name}/optee-os
# external dt U-boot
externaldt_uboot_path=CA7/DeviceTree/${your_cubemx_project_name}/u-boot
externaldt_uboot_programmer_path=CA7/DeviceTree/${your_cubemx_project_name}/u-boot
# TF-A
externaldt_tfa_path=CA7/DeviceTree/${your_cubemx_project_name}/tf-a
externaldt_tfa_programmer_path=CA7/DeviceTree/${your_cubemx_project_name}/tf-a
# Kernel linux
externaldt_linux_path=CA7/DeviceTree/${your_cubemx_project_name}/kernel

# Name of devicetree to use
# Optee dt name
optee_dt_name=${your_board_name}
optee_dt_programmer_name=${your_board_name}
# U-boot dt name
uboot_defconfig=${your_soc_name}_defconfig
uboot_dt_name=${your_board_name}
uboot_programmer_dt_name=${your_board_name}
# TF-A dt name
tfa_dt_name=${your_board_name}
tfa_dt_programmer_name=${your_board_name}
# Linux kernel dt name
linux_dtb_name=${your_board_name}

# ----------------------------
# Component configuration
# ----------------------------

PARALLEL_MAKE=
# parallel make argument:
# ex.: 
# PARALLEL_MAKE=-j8

# ----------------------------
# DEBUG/LOG parameters
#
# TF-A
# TF_A_DEBUG: activate debug log
# TF_A_LOG_LEVEL: level of log (Preconize 20 by default and 40 for debug)
# (uncomment and/or adapt to your need)
# export TF_A_DEBUG=0
# export TF_A_LOG_LEVEL=20

# ----------------------------
# OPTEE-OS
# ----------------------------
# DEBUG/LOG parameters
#
# OPTEE-OS
# OPTEE_DEBUG_CORE: activate debug core
#   For stm32mp15, OPTEE_DEBUG_CORE MUST be desactivated to save space on memory
# OPTEE_LOG_LEVEL: set log  level at runtime (Preconize 2 by default)
#    0: Minimum level
#    1: Error level
#    2: Info level
#    3: DEBUG level
#    4: Flow level (used to print the execution flox, typically the in/out of functions)
# (comment and/or adapt to your need)
export OPTEE_DEBUG_CORE=n
export OPTEE_LOG_LEVEL=2

# ----------------------------
# U-BOOT
# ----------------------------
# Configuration
# (list of fragments with relative path to source code)
# fragments available:
#   ../fragment-02-signature.fragment : For FIT usage, activate fit and signature
#   ../fragment-03-efi.fragment : For EFI usage, active support of load of EFI firwmare
#   ../fragment-06-m33td-no-splashscreen.fragment: For M33TD, permit to not activate splashscreen
#   ../fragment-07-firmware-update-ab.fragment : For firmware AB, adapt number of image available
# export UBOOT_FRAGMENT_LIST=""
# ex.: For firmware update AB you MUST use the fragment: fragment-07-firmware-update-ab.fragment
#    export UBOOT_FRAGMENT_LIST="../fragment-07-firmware-update-ab.fragment"
# export UBOOT_PROGRAMMER_FRAGMENT_LIST=""

# ----------------------------
# KERNEL
# ----------------------------
# Build parameters
# Verbose parameter to pass to Makefile
# (uncomment and/or adapt to your need)
# export VERBOSE_PARAM="V=1"

# Configuration
# (list of fragments with relative path to source code)
# List of fragments available:
#     fragment-03-systemd.config : configuration for systemd usage
#     fragment-04-modules.config : addons st configuration
# List of optional fragment available:
#     optional-fragment-05-signature.config : configuration to use signed modules
#     optional-fragment-06-nosmp.config : configuration to disable smp
#     optional-fragment-07-efi.config: configuration to enable EFI functionality
#     optional-fragment-07-efi-stm32mp1.config : specific addons cleanup for efi configuration for stm32mp1
#     optional-fragment-08-disable-etnaviv.config: configuration to disable etnaviv
export KERNEL_FRAGMENT_LIST="../fragment-03-systemd.config ../fragment-04-modules.config"

# ----------------------------
# Firmware update
# ----------------------------
# Firmware update is activated by default on component configuration

# There is several set of configuration for firmware update:
# 1: use the firmware update only on fip image
# 2: use the firmware update for fip and several linux fs (like bootfs, rootfs, ...)
# To use the second configuration for linux fs support with firmware update, you need to activate
# the following variable:
# export FIRMWARE_UPDATE_AB=1

# Metadata configuration:
# A specific configuration can by use for generating metadata firmware via TF-A Makefile:
# METADATA_IMAGE_NUMBER: number of image described on metadata
# METADATA_NAME: name of metadata firmware generated
# METADATA_TOOL_ARGS: configuration of metadata
#   METADATA_TOOL_ARGS=" -g -i <number of image> -b <number of bank> -v <metadata version: 1 or 2> \
#       <uuid image>,<uuid type of image>, <gpt uuid imge A>,<gpt uuid image B>  # for first image, can be repeated for each image \
#       .... \
#       "
export METADATA_IMAGE_NUMBER=1

# basic configuration of metadata which manage only fip image:
# export METADATA_IMAGE_NUMBER=1
# export METADATA_NAME="metadata_fip.bin"
# export METADATA_TOOL_ARGS="-g -i 1 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3"

# configuration of metadata which fip, bootfs and rootfs image on sdcard:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_sdcard.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c"

# configuration of metadata which fip, bootfs and rootfs image on emmc:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_emmc.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c"

# configuration of metadata which fip, bootfs, rootfs, vendorfs and userfs image on sdcard:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_vendorfs_userfs_sdcard.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,3f427af9-e80f-4811-bd33-29aaf35a28f8,8abdaae5-d940-463a-8326-a2c6af788fe6,d168dbce-65f3-423c-86af-a11528890b30 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,bf9b43d9-fcb3-4253-8297-afd9c68df1ef,2d750516-056c-4fae-9d73-f3141f1cffb4,7e036063-979d-4000-949d-33ab3e987de0 "

# configuration of metadata which fip, bootfs, rootfs, vendorfs and userfs image on emmc:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_vendorfs_userfs_emmc.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,3f427af9-e80f-4811-bd33-29aaf35a28f8,9fdbbc13-65d3-4419-9395-88c694a4ea79,4752ba24-2e0d-45b9-9c42-0028ece6e74b \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,bf9b43d9-fcb3-4253-8297-afd9c68df1ef,e873e5be-10d5-4670-b8f1-2905b5e7d992,445a0e58-aa95-4e75-8c4f-ff603dddb60f"

##################################################################
##################################################################
### End of general configuration
##################################################################
##################################################################

source sdk_action-common-for-stm32mp1-mx.source
