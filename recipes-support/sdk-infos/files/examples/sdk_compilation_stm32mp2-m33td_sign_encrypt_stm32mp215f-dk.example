#!/bin/bash

declare -A DEVICETREE_SUFFIX_ARRAY
DEVICETREE_SUFFIX_ARRAY[optee-emmc]="-emmc"
DEVICETREE_SUFFIX_ARRAY[optee-sdcard]="-sdcard"
DEVICETREE_SUFFIX_ARRAY[optee-nor]="-snor"
DEVICETREE_SUFFIX_ARRAY[optee-programmer-usb]=""
DEVICETREE_SUFFIX_ARRAY[optee-programmer-serial]=""
##################################################################
##################################################################
### General configuration
##################################################################
##################################################################
# Path to SDK environment (where is 'environment-setup-cortexa35-ostl-linux')
# Usually: /opt/st/stm32mp2/<X.X.X>-openstlinux-<X.X>-yocto-<version_name>-mpu-v<XX.XX.XX>/
sdk_absolute_path=<SDK absolute path>

# Name of environment setup script for sdk
sdk_env_file="environment-setup-cortexa35-ostl-linux"

# Configuration for building stm32mp2x-M33TD
your_board_name="stm32mp215f-dk"

# your_soc_name can be stm32mp21, stm32mp23, stm32mp25
your_soc_name="stm32mp21"

# Type of security can be 'optee' or 'opteemin' (optee is preconize for stm32mp2)
your_storage_boot_scheme_security="optee"

# Type of boot scheme storage used for Cortex A35 part, ex.:
#    optee-emmc
#    optee-sdcard
#    optee-nor
#    optee-nand
#    optee-spinand
your_storage_boot_scheme_cortex_a="optee-sdcard"

# Type of boot scheme storage used for Cortex M33 part, ex.:
#        m33td_emmc
#        m33td_nor
#        m33td_nor-emmc
#        m33td_nor-sdcard
#        m33td_sdcard
your_storage_boot_scheme_cortex_m="m33td_sdcard"

# Name of profile use to generate TF-M binaries, ex:
#        stm/stm32mp257f_ev1
#        stm/stm32mp215f_dk
#        stm/stm2mp2_generic
your_m33_profile="stm/stm32mp215f_dk"

# Name of project used on M33 processor, ex.:
#       StarterApp_M33TD
your_cube_m33td_project_name="StarterApp_M33TD"

# Path for project used on M33 processor, ex.:
#       Projects/STM32MP215F-DK/Demonstrations/StarterApp_M33TD
#       Projects/STM32MP235F-DK/Demonstrations/StarterApp_M33TD
#       Projects/STM32MP257F-DK/Demonstrations/StarterApp_M33TD
#       Projects/STM32MP257F-EV1/Demonstrations/StarterApp_M33TD
your_cube_m33td_project_path="Projects/STM32MP215F-DK/Demonstrations/StarterApp_M33TD"

# Specific cmake flags to apply for Cube M33TD project build, ex.:
#       -DBUILD_CONFIG=FULL -DBOOT_SPLASHSCREEN=STATIC
your_cube_m33td_bld_opts=""

# Location to store all the binaries generated
your_deploy_dir_path="$PWD/output-sdk-stm32mp215f-dk-m33td"

# Define build subdirectory (by default set to ../build)
your_build_subdir_path="../build-stm32mp215f-dk-m33td"

# Force header version number of M33 DDR firmware image
# (information set on image for firmware update)
# can be set via environment variable, ex.: SIGN_VERSION_DDR=1.1
export M33FW_SIGN_VERSION_DDR=${M33FW_SIGN_VERSION_DDR:-}

# Force header version number of M33 firmware image (secure+non secure)
# (information set on image for firmware update)
# can be set via environment variable, ex.: SIGN_VERSION_FW=1.2
export M33FW_SIGN_VERSION=${M33FW_SIGN_VERSION:-}

# Force header image confirm flag
# effective for M33 DDR firmware and M33 firmware
export M33FW_IMAGE_CONFIRM=1

# ----------------------------------------------------------------
# ----------------------------------------------------------------
### External DT configuration
# ----------------------------------------------------------------
# ----------------------------------------------------------------
# External DT  devicetree tree
#  <external dt path>/stm32mp2/m33-td/
#    ├── linux
#    ├── optee
#    ├── tf-a
#    ├── mcuboot
#    ├── tfm
#    └── u-boot

# ------------------------------
# Via external dt
# force external dt path to external-dt env path
# (EXTDT_DIR can be changed by overwriting the path on external-dt_set funcion)
externaldt_path=<externaldt_path>

# external dt subpath for Optee
externaldt_optee_path=stm32mp2/m33-td/optee
externaldt_optee_programmer_path=stm32mp2/m33-td/optee
# external dt U-boot
externaldt_uboot_path=stm32mp2/m33-td/u-boot
externaldt_uboot_programmer_path=stm32mp2/m33-td/u-boot
# TF-A
externaldt_tfa_path=stm32mp2/m33-td/tf-a
externaldt_tfa_programmer_path=stm32mp2/m33-td/tf-a
# TF-M
externaldt_tfm_path=stm32mp2/m33-td/tfm
externaldt_mcuboot_path=stm32mp2/m33-td/mcuboot
# Kernel linux
externaldt_linux_path=stm32mp2/m33-td/linux

# Name of devicetree to use
# Optee dt name
optee_dt_name=${your_board_name}-cm33tdcid-ostl${DEVICETREE_SUFFIX_ARRAY[${your_storage_boot_scheme_cortex_a}]}
optee_dt_programmer_name=${your_board_name}-cm33tdcid-ostl-serial-ca35tdcid
# U-boot dt name
uboot_defconfig=${your_soc_name}_defconfig
uboot_dt_name=${your_board_name}-cm33tdcid-ostl${DEVICETREE_SUFFIX_ARRAY[${your_storage_boot_scheme_cortex_a}]}
uboot_programmer_dt_name=${your_board_name}-cm33tdcid-ostl-serial-ca35tdcid
# TF-A dt name
tfa_dt_name=${your_board_name}-cm33tdcid-ostl${DEVICETREE_SUFFIX_ARRAY[${your_storage_boot_scheme_cortex_a}]}
tfa_dt_programmer_name=${your_board_name}-cm33tdcid-ostl-serial-ca35tdcid
# Linux kernel dt name
linux_dtb_name=${your_board_name}-cm33tdcid-ostl${DEVICETREE_SUFFIX_ARRAY[${your_storage_boot_scheme_cortex_a}]}
# TF-M dt name
tfm_dt_name=${your_board_name}-cm33tdcid-ostl

# Use externaldt suffix (defined via DEVICETREE_SUFFIX_ARRAY)
use_externaldt_suffix=1

# ----------------------------
# Component configuration
# ----------------------------

PARALLEL_MAKE=-j8
# parallel make argument:
# ex.: 
# PARALLEL_MAKE=-j8

# ----------------------------
# DEBUG/LOG parameters
#
# TF-A
# TF_A_DEBUG: activate debug log
# TF_A_LOG_LEVEL: level of log (Preconize 20 by default and 40 for debug)
# (uncomment and/or adapt to your need)
# export TF_A_DEBUG=0
# export TF_A_LOG_LEVEL=20

# ----------------------------
# OPTEE-OS
# ----------------------------
# DEBUG/LOG parameters
#
# OPTEE-OS
# OPTEE_DEBUG_CORE: activate debug core
# OPTEE_LOG_LEVEL: set log  level at runtime (Preconize 2 by default)
#    0: Minimum level
#    1: Error level
#    2: Info level
#    3: DEBUG level
#    4: Flow level (used to print the execution flox, typically the in/out of functions)
# (comment and/or adapt to your need)
export OPTEE_DEBUG_CORE=y
export OPTEE_LOG_LEVEL=2

# ----------------------------
# U-BOOT
# ----------------------------
# Configuration
# (list of fragments with relative path to source code)
# fragments available:
#   ../fragment-02-signature.fragment : For FIT usage, activate fit and signature
#   ../fragment-03-efi.fragment : For EFI usage, active support of load of EFI firwmare
#   ../fragment-06-m33td-no-splashscreen.fragment: For M33TD, permit to not activate splashscreen
#   ../fragment-07-firmware-update-ab.fragment : For firmware AB, adapt number of image available
# export UBOOT_FRAGMENT_LIST=""
# ex.: For firmware update AB you MUST use the fragment: fragment-07-firmware-update-ab.fragment
#    export UBOOT_FRAGMENT_LIST="../fragment-07-firmware-update-ab.fragment"
# export UBOOT_PROGRAMMER_FRAGMENT_LIST=""

# ----------------------------
# KERNEL
# ----------------------------
# Build parameters
# Verbose parameter to pass to Makefile
# (uncomment and/or adapt to your need)
# export VERBOSE_PARAM="V=1"

# Configuration
# (list of fragments with relative path to source code)
# List of fragments available:
#     fragment-03-systemd.config : configuration for systemd usage
#     fragment-04-modules.config : addons st configuration
# List of optional fragment available:
#     optional-fragment-05-signature.config : configuration to use signed modules
#     optional-fragment-06-nosmp.config : configuration to disable smp
#     optional-fragment-07-efi.config: configuration to enable EFI functionality
#     optional-fragment-07-efi-stm32mp1.config : specific addons cleanup for efi configuration for stm32mp1
#     optional-fragment-08-disable-etnaviv.config: configuration to disable etnaviv
export KERNEL_FRAGMENT_LIST="../fragment-03-systemd.config ../fragment-04-modules.config"

# ----------------------------
# TF-M
# ----------------------------
# TF-M profile:
# Profile Small: Designed for ultra-constrained devices with a minimal memory footprint;
# uses isolation level 1 (SFN backend) and requires symmetric cryptography (like TLS-PSK).
# export TF_M_PROFILE=profile_small
#
# Profile Medium: Targets standard IoT requirements with isolation level 2 (IPC) and adds
# features like Protected Storage alongside Crypto, ITS, and Attestation.
# export TF_M_PROFILE=profile_medium

# ----------------------------
# Firmware update
# ----------------------------
# Firmware update is activated by default on component configuration

# There is several set of configuration for firmware update:
# 1: use the firmware update only on fip image
# 2: use the firmware update for fip and several linux fs (like bootfs, rootfs, ...)
# To use the second configuration for linux fs support with firmware update, you need to activate
# the following variable:
# export FIRMWARE_UPDATE_AB=1

# Metadata configuration:
# A specific configuration can by use for generating metadata firmware via TF-A Makefile:
# METADATA_IMAGE_NUMBER: number of image described on metadata
# METADATA_NAME: name of metadata firmware generated
# METADATA_TOOL_ARGS: configuration of metadata
#   METADATA_TOOL_ARGS=" -g -i <number of image> -b <number of bank> -v <metadata version: 1 or 2> \
#       <uuid image>,<uuid type of image>, <gpt uuid imge A>,<gpt uuid image B>  # for first image, can be repeated for each image \
#       .... \
#       "
export METADATA_IMAGE_NUMBER=1

# basic configuration of metadata which manage only fip image:
# export METADATA_IMAGE_NUMBER=1
# export METADATA_NAME="metadata_fip.bin"
# export METADATA_TOOL_ARGS="-g -i 1 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3"

# configuration of metadata which fip, bootfs and rootfs image on sdcard:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_sdcard.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c"

# configuration of metadata which fip, bootfs and rootfs image on emmc:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_emmc.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c"

# configuration of metadata which fip, bootfs, rootfs, vendorfs and userfs image on sdcard:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_vendorfs_userfs_sdcard.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,3f427af9-e80f-4811-bd33-29aaf35a28f8,8abdaae5-d940-463a-8326-a2c6af788fe6,d168dbce-65f3-423c-86af-a11528890b30 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,bf9b43d9-fcb3-4253-8297-afd9c68df1ef,2d750516-056c-4fae-9d73-f3141f1cffb4,7e036063-979d-4000-949d-33ab3e987de0 "

# configuration of metadata which fip, bootfs, rootfs, vendorfs and userfs image on emmc:
# export METADATA_IMAGE_NUMBER=3
# export METADATA_NAME="metadata_fip_bootfs_rootfs_vendorfs_userfs_emmc.bin"
# export METADATA_TOOL_ARGS="-g -i 3 -b 2 -v 2 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,19d5df83-11b0-457b-be2c-7559c13142a5,4fd84c93-54ef-463f-a7ef-ae25ff887087,09c54952-d5bf-45af-acee-335303766fb3 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,8da7c9d3-d368-487b-b28b-71e1b0c68cf0,0ef36fac-9ba4-4e39-823a-bbb2336c32be,f2c429f5-9000-4201-aa0f-96a95ea8d9f9 \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,b28961f8-c72c-4088-bbdb-c785861473fa,491f6117-415d-4f53-88c9-6e0de54deac6,6e01295a-8f81-47d5-945c-cb144ae7500c \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,3f427af9-e80f-4811-bd33-29aaf35a28f8,9fdbbc13-65d3-4419-9395-88c694a4ea79,4752ba24-2e0d-45b9-9c42-0028ece6e74b \
#    8a7a84a0-8387-40f6-ab41-a8b9a5a60d23,bf9b43d9-fcb3-4253-8297-afd9c68df1ef,e873e5be-10d5-4670-b8f1-2905b5e7d992,445a0e58-aa95-4e75-8c4f-ff603dddb60f"

##################################################################
##################################################################
### End of general configuration
##################################################################
##################################################################

##################################################################
##################################################################
### Signature / Encryption configuration
##################################################################
##################################################################
#
#          STM32MP2: CORTEX A35 A35TD               CORTEX M33
#   ---------------------------------------    ---------------------
#   |                   BL2               |   |       BL2          |
#   |                 (TF-A)              |   |   (TF-M MCUBOOT)   |
#   |                                     |   |                    |
#   |    verified with  | decrypted with  |   | verified with      |
#   |       OEM-KEY1    |   EDMK1-128b    |   |   OEM-KEY2         |
#   |                                     |   |  (or OEM-KEY1)     |
#   --------------------------------------    ----------------------
#   |                 FIP                 |   |       DDR FW       |
#   |        (FW-CONFIG - TF-A)           |   |    (TF-M)          |
#   |               (optee)               |   |                    |
#   [          (DDR fw - TF-A)            |   |   verified with    |
#   |                                     |   |  FSBLM-DDR-FW-PKH  |
#   |    verified with  | decrypted with  |   ----------------------
#   |      OEM-KEY1     |     FIP-EDMK    |   |       M33 FW       |
#    --------------------------------------   |                    |
#                                             |   verified with    |
#                                             |  FSBLM-M33-FW-PKH  |
#                                             ----------------------
#
#
# WARNING: For FIP will be verified (and decrypted) by BL2, you need to compile
#   TF-A with specific option for signature support:
#     for all platform: TRUSTED_BOARD_BOOT=1 MBEDTLS_DIR=<path to mbedtls source code> BRANCH_PROTECTION=0
#   TF-A with specific option for encryption support:
#     for all platform: DECRYPTION_SUPPORT=aes_gcm ENCRYPT_BL32=1 MBEDTLS_DIR=<path to mbedtls source code>
#

# Activate signature for BL2 and FIP on cortex A35
SIGN_ENABLE=0

# Activate Encryption for BL2 and FIP on cortex A35
ENCRYPT_ENABLE=0

# Activate signature during for loading firmware on Cortex M33 (coprocessor)
SIGN_COPRO_ENABLE=0
# Activate encryption during for loading firmware on Cortex M33 (coprocessor)
ENCRYPT_COPRO_ENABLE=0

# Absolute path to signing tools
SIGN_TOOL="<absolute path>/STM32CubeProgrammer-x.xx/bin/STM32_SigningTool_CLI"

# Directory on which all key are available
your_absolute_key_path=<absolute path to key directory>

# For naming the output file, use the following suffix:
signature_suffix="_Signed"
encryption_suffix="_Encrypted"

# ------ Key associated to OEM-KEY1 ---------------------
# Private Key for signature (absolute path to key)
SIGN_KEY="${your_absolute_key_path}/a35_OEM-KEY1_privateKey00.pem"
# List of Public key for signature
# NOTE:
# for stm32mp2 platform, 8 key pairs public/private are supported
SIGN_KEY_PUB="\
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey00.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey01.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey02.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey03.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey04.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey05.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey06.pem \
    ${your_absolute_key_path}/a35_OEM-KEY1_publicKey07.pem \
"
# Password (key pass) for all signature key
# NOTE:
# for stm32mp2 platform, up to 8 keys can be requested (means put all password according to key)
SIGN_KEY_PASS="pass0 pass1 pass2 pass3 pass4 pass5 pass6 pass7"

# Password key associated to private key selected via SIGN_KEY
SIGN_KEY_PASS_FOR_SPECIFC_KEY="pass0"

# ------ Key associated to EDMK1-128b------------
# encryption key use to decrypt Bl2 (TF-A) (128bits)
ENCRYPT_FSBL_KEY="${your_absolute_key_path}/a35_EDMK1-128b_key_128bits.bin"

# ------ Key associated to OEM-KEY2 ---------------------
# NOTE: if OEM-KEY1 is configured on OTP for verifying Cortex M33 BL2
#     You need to configure the following variable as OEM-KEY1

USE_SAME_KEY_FOR_OEM_KEY1_AND_OEM_KEY2=1
if [ ${USE_SAME_KEY_FOR_OEM_KEY1_AND_OEM_KEY2} -eq 1 ]; then
    # USING OEM-KEY1 for Cortex M33 BL2 verification
    # Private Key for signature (absolute path to key)
    SIGN_KEY_M="${your_absolute_key_path}/a35_OEM-KEY1_privateKey00.pem"
    # List of Public key for signature
    # NOTE:
    # for stm32mp2 platform, 8 key pairs public/private are supported
    SIGN_KEY_PUB_M="\
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey00.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey01.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey02.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey03.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey04.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey05.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey06.pem \
        ${your_absolute_key_path}/a35_OEM-KEY1_publicKey07.pem \
    "
    # Password (key pass) for all signature key
    # NOTE:
    # for stm32mp2 platform, up to 8 keys can be requested (means put all password according to key)
    SIGN_KEY_PASS_M="pass0 pass1 pass2 pass3 pass4 pass5 pass6 pass7"

    # Password key associated to private key selected via SIGN_KEY
    SIGN_KEY_PASS_M_FOR_SPECIFC_KEY="pass0"

    # ------ Key associated to EDMK1-128b------------
    # encryption key use to decrypt Bl2 (TF-A) (128bits)
    ENCRYPT_FSBL_M_KEY="${your_absolute_key_path}/a35_EDMK1-128b_key_128bits.bin"

else
    # USING two separate key, one for Cortex A35 one for CortexM33
    # Private Key for signature (absolute path to key)
    SIGN_KEY_M="${your_absolute_key_path}/m33_OEM-KEY2_privateKey00.pem"
    # List of Public key for signature
    # NOTE:
    # for stm32mp2 platform, 8 key pairs public/private are supported
    SIGN_KEY_PUB_M="\
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey00.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey01.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey02.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey03.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey04.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey05.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey06.pem \
        ${your_absolute_key_path}/m33_OEM-KEY2_publicKey07.pem \
    "
    # Password (key pass) for all signature key
    # NOTE:
    # for stm32mp2 platform, up to 8 keys can be requested (means put all password according to key)
    SIGN_KEY_PASS_M="passM0 passM1 passM2 passM3 passM4 passM5 passM6 passM7"

    # Password key associated to private key selected via SIGN_KEY
    SIGN_KEY_PASS_M_FOR_SPECIFC_KEY="passM0"

    # ------ Key associated to EDMK2-128b------------
    # encryption key use to decrypt Bl2 (TF-A) (128bits)
    ENCRYPT_FSBL_M_KEY="${your_absolute_key_path}/m33_EDMK2-128b_key_128bits.bin"

fi

# ------ Key associated to FSBLM-DDR-FW-PKH ---------------------
SIGN_M33DDR_KEY="${your_absolute_key_path}/m33_FSBLM-DDR-FW-PKH_privateKey.pem"
SIGN_M33DDR_KEY_PASS="passddr"

# ------ Key associated to FSBLM-M33-FW-PKH ---------------------
SIGN_M33FW_KEY="${your_absolute_key_path}/m33_FSBLM-M33-FW-PKH_privateKey.pem"
SIGN_M33FW_KEY_PASS="passfw"

# ------ Key associated to FIP-EDMK------------
# encryption key use to decrypt FIP component (256bits)
ENCRYPT_FIP_KEY="${your_absolute_key_path}/a35_FIP-EDMK_key_256bits.bin"

# ------ Key associated to RPROC-FW-PKH for coprocessor signature----------
# Type of key use for coprocessor signature:
# (256bits symmetric key)
#  RSA: Asymetric cryptography algorithm
#  ECC: Elliptic curve cryptography
SIGN_COPRO_TYPE=ecc

# For RSA KEY
SIGN_COPRO_RSA_INFOKEY=""
SIGN_COPRO_RSA_PRIVKEY=""
SIGN_COPRO_RSA_PASS=""

# For ECC KEY
SIGN_COPRO_ECC_INFOKEY="${your_absolute_key_path}/m33_RPROC-FW-PKH_ecc_publicKey.der"
SIGN_COPRO_ECC_PRIVKEY="${your_absolute_key_path}/m33_RPROC-FW-PKH_ecc_privateKey.pem"
SIGN_COPRO_ECC_PASS="passrproc"

# ------ Key associated to RPROC-FW-ENC-KEY for coprocessor encryption-------
# Encryption key (256bits)
ENCRYPT_COPRO_KEY="${your_absolute_key_path}/m33_RPROC-FW-ENC-KEY_key_256bits.bin"

##################################################################
##################################################################
### End of Signature / Encryption configuration
##################################################################
##################################################################

##################################################################
##################################################################
### Signature / Encryption configuration
##################################################################
##################################################################
if [ ${SIGN_ENABLE} -eq 1 ]; then
      export TF_A_DEBUG=0
      export TF_A_LOG_LEVEL=20
fi
##################################################################
##################################################################
### RESTRICTION of Signature / Encryption
##################################################################
##################################################################

source sdk_action-common-for-stm32mp2-m33td-with-security.source
