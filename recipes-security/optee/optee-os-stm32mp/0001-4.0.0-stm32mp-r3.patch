+static TEE_Result clk_stm32_rif_gate_enable(struct clk *clk)
+{
+	struct clk_stm32_rif_gate_cfg *cfg = clk->priv;
+
+	if (stm32_rcc_has_access_by_id(cfg->sec_id))
+		stm32_gate_enable(cfg->gate_id);
