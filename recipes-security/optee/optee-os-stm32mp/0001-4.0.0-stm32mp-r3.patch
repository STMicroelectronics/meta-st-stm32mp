+/*
+ * SCMI module -> SCMI clock module interface
+ */
+static int scmi_clock_get_scmi_protocol_id(fwk_id_t protocol_id,
+                                           uint8_t *scmi_protocol_id)
+{
+    *scmi_protocol_id = (uint8_t)MOD_SCMI_PROTOCOL_ID_CLOCK;
+
+    return FWK_SUCCESS;
+}
