+ */
+static const fwk_id_t mod_cdns_i2c_notification_id_target_tx =
+    FWK_ID_NOTIFICATION_INIT(
+        FWK_MODULE_IDX_CDNS_I2C,
+        MOD_CDNS_I2C_NOTIFICATION_IDX_TX);
+
