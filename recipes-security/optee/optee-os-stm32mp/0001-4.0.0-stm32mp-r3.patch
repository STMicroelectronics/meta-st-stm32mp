+#ifdef CFG_STM32_RIF
+static bool pin_is_accessible(struct stm32_gpio_bank *bank, unsigned int pin)
+{
+	TEE_Result res = TEE_ERROR_GENERIC;
+	bool accessible = false;
+	uint32_t cidcfgr = 0;
+
