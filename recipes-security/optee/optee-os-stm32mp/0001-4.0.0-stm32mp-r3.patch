-void stm32mp_register_secure_pinctrl(struct pinctrl_state *pinctrl)
-{
-	unsigned int *bank = NULL;
-	unsigned int *pin = NULL;
-	size_t count = 0;
-	size_t n = 0;
-
-	stm32_gpio_pinctrl_bank_pin(pinctrl, NULL, NULL, &count);
