+	.disable	= clk_stm32_rif_composite_gate_disable,
+	.is_enabled	= clk_stm32_rif_composite_gate_is_enabled,
+	.save_context	= clk_stm32_pm_save_rate,
+	.restore_context = clk_stm32_rif_composite_pm_restore,
+};
