+    clock_ref_count_init();
+    TEST_ASSERT_EQUAL_INT8_ARRAY(
+        agent_clock_state_table_default,
+        agent_clock_state_table,
+        FAKE_SCMI_AGENT_IDX_COUNT * CLOCK_DEV_IDX_COUNT);
