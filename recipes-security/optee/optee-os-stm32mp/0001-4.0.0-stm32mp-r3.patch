+
+#ifndef MOD_OPTEE_CLOCK_H
+#define MOD_OPTEE_CLOCK_H
+
+#include <fwk_element.h>
+#include <fwk_macros.h>
+
+#include <drivers/clk.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+
