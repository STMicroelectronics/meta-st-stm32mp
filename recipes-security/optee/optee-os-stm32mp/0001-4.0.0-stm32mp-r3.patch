+psa_status_t psa_aead_verify(psa_aead_operation_t *operation,
+			     uint8_t *plaintext,
+			     size_t plaintext_size,
+			     size_t *plaintext_length,
+			     const uint8_t *tag,
+			     size_t tag_length)
