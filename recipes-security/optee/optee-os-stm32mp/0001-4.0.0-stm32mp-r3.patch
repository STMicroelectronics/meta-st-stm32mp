+static TEE_Result clk_stm32_composite_get_duty_cycle(struct clk *clk,
+						     struct clk_duty *duty)
+{
+	struct clk_stm32_composite_cfg *cfg = clk->priv;
+	uint32_t val = stm32_div_get_value(cfg->div_id);
