+#define OP_NBW_FROM_SIZE(s)		OP_NBW_FROM_LEN((s) * INT8_LEN)
+#define OP_SIZE_FROM_SIZE(s)		(OP_NBW_FROM_SIZE(s) * WORD_SIZE)
+
+#define MAX_EO_NBW			OP_NBW_FROM_LEN(PKA_MAX_ECC_LEN)
+
+/* PKA registers */
+#define _PKA_CR				0x0U
+#define _PKA_SR				0x4U
