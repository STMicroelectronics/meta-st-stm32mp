@@ -0,0 +1,472 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2020-2024, STMicroelectronics
+ */
+
+#include <config.h>
+#include <drivers/gpio.h>
+#include <drivers/regulator.h>
