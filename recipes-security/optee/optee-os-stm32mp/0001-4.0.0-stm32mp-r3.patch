+					   uint32_t (*cb)(int id))
+{
+	size_t i = 0;
+	struct stm32_tamp_conf *tamp_conf = NULL;
+
+	if (!stm32_tamp.pdata.compat)
+		return TEE_ERROR_BAD_STATE;
+
+	if (!cb)
+		return TEE_ERROR_BAD_PARAMETERS;
+
