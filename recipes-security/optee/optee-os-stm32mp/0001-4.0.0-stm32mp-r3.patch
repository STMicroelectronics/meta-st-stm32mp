+/*!
+ * \brief SCMI Voltage Domain Protocol
+ */
+#define MOD_SCMI_PROTOCOL_ID_VOLTAGE_DOMAIN UINT32_C(0x17)
+
+/*!
+ * \brief SCMI Voltage Domain Protocol Message IDs
