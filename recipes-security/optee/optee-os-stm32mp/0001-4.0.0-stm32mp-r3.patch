+    MOD_SCMI_VOLTD_CONFIG_GET = 0x006,
+    MOD_SCMI_VOLTD_LEVEL_SET = 0x007,
+    MOD_SCMI_VOLTD_LEVEL_GET = 0x008,
+    MOD_SCMI_VOLTD_COMMAND_COUNT,
+};
+
+/*!
+ * \}
+ */
+
+/*!
+ * \}
+ */
+
+#endif /* MOD_SCMI_STD_H */
