+#include <mod_resource_perms.h>
+#include <mod_scmi_std.h>
+
+#include <fwk_assert.h>
+#include <fwk_log.h>
+#include <fwk_mm.h>
+#include <fwk_module.h>
+#include <fwk_module_idx.h>
