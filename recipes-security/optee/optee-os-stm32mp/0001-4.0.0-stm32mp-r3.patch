+    assert(result == FWK_SUCCESS);
+
+    set_isr_param_return_val = FWK_E_HANDLER;
+    set_isr_nmi_param_return_val = FWK_SUCCESS;
+    result = fwk_interrupt_set_isr_param(FWK_INTERRUPT_NMI, fake_isr_param, 0);
