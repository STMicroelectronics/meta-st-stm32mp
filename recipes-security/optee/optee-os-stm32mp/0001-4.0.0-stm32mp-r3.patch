+	SLIST_FOREACH(prv, &pmic_it_handle_list, link) {
+		if (stpmic1_register_update(prv->pmic_reg,
+					    BIT(prv->pmic_bit),
+					    BIT(prv->pmic_bit)))
+			panic();
+	}
+
+	stm32mp_put_pmic();
+}
