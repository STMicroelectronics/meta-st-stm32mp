+/* High Speed Low Voltage domains IDs for STM32MP13 variants */
+enum stm32mp13_hslv_id {
+	SYSCFG_HSLV_IDX_TPIU = 0,
+	SYSCFG_HSLV_IDX_QSPI,
+	SYSCFG_HSLV_IDX_ETH1,
