+	psa_status_t status;
+	struct tfm_crypto_pack_iovec iov = {
+		.function_id = TFM_CRYPTO_AEAD_VERIFY_SID,
+		.op_handle = operation->handle,
+	};
+
+	psa_invec in_vec[] = {
+		{.base = &iov, .len = sizeof(struct tfm_crypto_pack_iovec)},
+		{.base = tag, .len = tag_length}
+	};
+	psa_outvec out_vec[] = {
+		{.base = &(operation->handle), .len = sizeof(uint32_t)},
+		{.base = plaintext, .len = plaintext_size}
+	};
+
+	size_t out_len = IOVEC_LEN(out_vec);
+
+	/* Sanitize the optional output */
+	if ((!plaintext) && (plaintext_size))
+		return PSA_ERROR_INVALID_ARGUMENT;
+
+	if (!plaintext || plaintext_size == 0)
+		out_len--;
+	if ((out_len == 2) && (!plaintext_length))
+		return PSA_ERROR_INVALID_ARGUMENT;
+
+	status = psa_call(RSE_CRYPTO_HANDLE, PSA_IPC_CALL,
+			  in_vec, IOVEC_LEN(in_vec),
+			  out_vec, out_len);
+
+	if (out_len == 2)
+		*plaintext_length = out_vec[1].len;
+	else
+		*plaintext_length = 0;
+
+	return status;
+}
