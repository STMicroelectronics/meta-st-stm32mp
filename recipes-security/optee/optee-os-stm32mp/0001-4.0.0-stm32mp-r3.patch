+#include <malloc.h>
+
+#include <mod_tfm_mbx.h>
+
+#include <arch_interrupt.h>
+#include <arch_main.h>
+#include "psa/service.h"
+
+void panic(void)
+{
+    psa_panic();
+}
+
+static const struct fwk_arch_init_driver scmi_init_driver = {
+    .interrupt = arch_interrupt_init,
+};
+
+int scmi_arch_init(void)
+{
+    int status;
+
+    status = fwk_arch_init(&scmi_init_driver);
+
+    fwk_log_flush();
+
+    return status;
+}
+
+int scmi_arch_deinit(void)
+{
+    return fwk_arch_deinit();
+}
+
+int scmi_get_devices_count(void)
+{
+    return tfm_mbx_get_devices_count();
+}
+
+int scmi_get_device(unsigned int id)
+{
+    fwk_id_t device_id;
+
+    device_id = tfm_mbx_get_device(id);
+
+    if (fwk_id_is_type(device_id, FWK_ID_TYPE_NONE)) {
+        return -1;
+    }
+
+    return (int)device_id.value;
+}
+
+void scmi_process_mbx_smt(unsigned int fwk_id)
+{
+#ifdef BUILD_HAS_MOD_TFM_SMT
+    fwk_id_t device_id;
+
+    device_id.value = fwk_id;
+
+    tfm_mbx_signal_smt_message(device_id);
+
+    fwk_process_event_queue();
+
+    fwk_log_flush();
+#endif
+}
+
+void scmi_provide_mbx_msg(unsigned int fwk_id, void *out_buf, size_t *out_size)
+{
+#ifdef BUILD_HAS_MOD_MSG_SMT
+    fwk_id_t device_id;
+
+    device_id.value = fwk_id;
+    tfm_mbx_signal_msg_message(device_id, NULL, 0, out_buf, out_size);
+    fwk_log_flush();
+#endif
+}
+
+void scmi_process_mbx_msg(unsigned int fwk_id, void *in_buf, size_t in_size,
+                          void *out_buf, size_t *out_size)
+{
+#ifdef BUILD_HAS_MOD_MSG_SMT
+    fwk_id_t device_id;
+
+    device_id.value = fwk_id;
+
+    tfm_mbx_signal_msg_message(device_id, in_buf, in_size, out_buf, out_size);
+
+    fwk_process_event_queue();
+
+    fwk_log_flush();
+#endif
+}
