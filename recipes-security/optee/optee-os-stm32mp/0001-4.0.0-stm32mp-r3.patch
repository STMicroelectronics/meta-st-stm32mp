+static TEE_Result stm32_tamp_configure_int(struct stm32_tamp_conf *tamp_int,
+					   uint32_t mode,
+					   uint32_t (*cb)(int id))
+{
+	TEE_Result res = TEE_ERROR_GENERIC;
