+void mutex_pm_aware_unlock(struct mutex_pm_aware *m)
+{
+	if (thread_is_for_pm()) {
+		assert(!m->mutex.state);
+		cpu_spin_unlock(&m->lock);
+	} else {
+		thread_spin_unlock(&m->lock);
+		mutex_unlock(&m->mutex);
+	}
