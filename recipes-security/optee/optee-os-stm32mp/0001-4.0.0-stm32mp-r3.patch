+#ifndef <DEVICE>_H
+#define <DEVICE>_H
+
+#include <fwk_macros.h>
+
+#include <stdint.h>
+
+struct device_reg {
+    /* Readable and writable register */
+    FWK_RW uint32_t <REGISTER NAME>;
+           uint32_t RESERVED1;
+
+    /* Write-only register */
+    FWK_W  uint32_t <REGISTER NAME>;
+
