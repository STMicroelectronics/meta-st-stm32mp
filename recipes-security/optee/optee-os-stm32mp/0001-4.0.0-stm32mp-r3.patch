+static uint32_t imr_pd_core_mask[EXTI_BANK_NR] = {
+	IMR1_PD_CORE_MASK,
+	IMR2_PD_CORE_MASK,
+	IMR3_PD_CORE_MASK,
+};
+
+static uint32_t imr_pd_core_ret_mask[EXTI_BANK_NR] = {
+	IMR1_PD_CORE_RET_MASK,
+	IMR2_PD_CORE_RET_MASK,
+	IMR3_PD_CORE_RET_MASK,
