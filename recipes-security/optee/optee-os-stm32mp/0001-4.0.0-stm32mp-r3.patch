+#define IMR3_PD_CORE_MASK (GENMASK_32(1, 0) | GENMASK_32(9, 4) | BIT(11))
+
+/*
+ * Valid wake-up source from LPLV-Stop modes are:
+ * GPIOs   0..15
+ * PVD/AVD 16
