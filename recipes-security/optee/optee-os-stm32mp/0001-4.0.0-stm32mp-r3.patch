+
+static void test_fwk_interrupt_set_isr(void)
+{
+    int result;
+
+    result = fwk_interrupt_set_isr(INTERRUPT_ID, NULL);
+    assert(result == FWK_E_PARAM);
+
+    set_isr_return_val = FWK_SUCCESS;
+    result = fwk_interrupt_set_isr(INTERRUPT_ID, fake_isr);
