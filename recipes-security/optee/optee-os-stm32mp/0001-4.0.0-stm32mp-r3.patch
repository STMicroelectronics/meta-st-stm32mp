+/*
+ * DVFS API
+ */
+
+/*!
+ * \brief Get the current operating point of a domain.
+ *
+ * \param domain_id Element identifier of the domain.
+ * \param [out] opp Current operating point.
+ */
+int mod_dvfs_domain_api_get_current_opp(
