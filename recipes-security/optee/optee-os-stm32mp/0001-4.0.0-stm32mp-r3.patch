diff --git a/core/lib/scmi-server/SCP-firmware/module/statistics/src/mod_stats.c b/core/lib/scmi-server/SCP-firmware/module/statistics/src/mod_stats.c
new file mode 100644
index 000000000..38c085d08
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/module/statistics/src/mod_stats.c
@@ -0,0 +1,610 @@
