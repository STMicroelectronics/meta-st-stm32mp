+static void test_fwk_module_is_valid_module_id(void)
+{
+    fwk_id_t id;
+    bool result;
+
+    /* Valid module ID */
+    id = fwk_module_id_fake0;
+    result = fwk_module_is_valid_module_id(id);
+    assert(result);
+
+    /* Valid module ID */
+    id = fwk_module_id_fake1;
+    result = fwk_module_is_valid_module_id(id);
+    assert(result);
+
+    /* ID larger than the number of modules */
+    id = FWK_ID_MODULE(0x3);
+    result = fwk_module_is_valid_module_id(id);
+    assert(!result);
+
+    /* Invalid type */
+    id = ELEM0_ID;
+    result = fwk_module_is_valid_module_id(id);
+    assert(!result);
+}
