+		&ck_lsi,
+		&ck_lse,
+		&ck_icn_hs_mcu,
+		&ck_icn_ls_mcu,
+		&ck_icn_sdmmc,
+		&ck_icn_ddr,
+		&ck_icn_display,
+		&ck_icn_hsl,
+		&ck_icn_nic,
+		&ck_flexgen_63,
+		&ck_cpu1,
+		&ck_icn_p_syscpu1,
+		&ck_icn_s_ddr,
+		&ck_icn_p_ddrc,
+		&ck_icn_p_ddrcfg,
+		&ck_icn_p_ddrphyc,
+		&ck_icn_p_risaf4,
+		&ck_icn_s_sysram,
+		&ck_icn_s_bkpsram,
+		&ck_ker_fmc,
+		&ck_ker_ospi1,
+		&ck_icn_p_hpdma1,
+		&ck_icn_p_hpdma2,
+		&ck_icn_p_hpdma3,
+		&ck_icn_p_gpioa,
+		&ck_icn_p_gpiob,
+		&ck_icn_p_gpioc,
+		&ck_icn_p_gpiod,
+		&ck_icn_p_gpioe,
+		&ck_icn_p_gpiof,
+		&ck_icn_p_gpiog,
+		&ck_icn_p_gpioh,
+		&ck_icn_p_gpioi,
+		&ck_icn_p_gpioz,
+		&ck_icn_p_ipcc1,
+		&ck_icn_p_rtc
+#endif /* CFG_STM32_CM33TDCID */
+	};
+	size_t i = 0;
+
+	for (i = 0; i < ARRAY_SIZE(clk_criticals); i++) {
+		struct clk *clk_critical = clk_criticals[i];
+
+		if (clk == clk_critical)
+			return true;
