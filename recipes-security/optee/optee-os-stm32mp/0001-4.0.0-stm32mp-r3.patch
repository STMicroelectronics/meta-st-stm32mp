index 000000000..6c4a0e16e
--- /dev/null
+++ b/core/arch/arm/plat-stm32mp1/pm/pm_helpers.S
@@ -0,0 +1,752 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
