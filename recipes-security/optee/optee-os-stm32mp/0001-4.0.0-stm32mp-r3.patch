+			'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P',
+			'A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', 0,
+			'Z', 'X', 'C', 'V', 'B', 'N', 'M', 0, 0, 0,
+		},
+		.columns = 10,
