+    return (const struct fwk_element *)optee_regu_elt;
+}
+
+struct fwk_module_config config_optee_voltd_regulator = {
+    .elements = FWK_MODULE_DYNAMIC_ELEMENTS(optee_voltd_regulator_get_element_table),
+};
