+void mutex_pm_aware_lock(struct mutex_pm_aware *m)
+{
+	if (thread_is_for_pm()) {
+		if (!cpu_spin_trylock(&m->lock) || m->mutex.state)
+			panic();
+	} else {
+		mutex_lock(&m->mutex);
+		if (!thread_spin_trylock(&m->lock))
+			panic();
+	}
+}
