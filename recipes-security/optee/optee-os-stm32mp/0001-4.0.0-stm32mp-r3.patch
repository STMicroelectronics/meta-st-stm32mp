+#define _RIFSC_HWCFGR1_CFG5_MASK	GENMASK_32(19, 16)
+#define _RIFSC_HWCFGR1_CFG5_SHIFT	U(16)
+#define _RIFSC_HWCFGR1_CFG6_MASK	GENMASK_32(23, 20)
+#define _RIFSC_HWCFGR1_CFG6_SHIFT	U(20)
