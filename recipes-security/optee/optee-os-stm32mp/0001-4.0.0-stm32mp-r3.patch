+static int qsort_cmp_int(const void *a, const void *b)
+{
+	const int *ia = a;
+	const int *ib = b;
+
+	return CMP_TRILEAN(*ia, *ib);
+}
+
+static int qsort_cmp_uint(const void *a, const void *b)
+{
+	const unsigned int *ia = a;
+	const unsigned int *ib = b;
+
+	return CMP_TRILEAN(*ia, *ib);
