+static const struct clk_ops clk_stm32_osc_ops = {
+	.enable		= clk_stm32_osc_enable,
+	.disable	= clk_stm32_osc_disable,
+	.is_enabled	= clk_stm32_gate_is_enabled,
+	.restore_context = clk_stm32_osc_pm_restore,
+};
