@@ -1761,6 +1799,22 @@ static int cortex_a_set_watchpoint(struct target *target, struct watchpoint *wat
 		break;
 	}
 
+	uint8_t load_store_access_control;
+	switch (watchpoint->rw) {
+	case WPT_READ:
+		load_store_access_control = 1;
+		break;
+	case WPT_WRITE:
