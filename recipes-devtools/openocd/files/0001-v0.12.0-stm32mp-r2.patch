+				write_memory 0x40470000 32 [expr {$icache_cr | 2}]
+				# wait for ICACHE_SR:BUSYF == 0
+				while {[expr {[read_memory 0x40470004 32 1] & 0x01}]} {
+					sleep 1
+				}
+			}
+			return
+		}
+
+		return
+	}
+}
