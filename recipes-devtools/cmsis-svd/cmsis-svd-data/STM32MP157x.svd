          <description>Refer to Section39.6.9: CRYP key register 0L (CRYP_K0LR) for details.</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
