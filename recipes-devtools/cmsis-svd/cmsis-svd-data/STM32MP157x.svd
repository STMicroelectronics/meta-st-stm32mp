              <description>UP</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ETH_MACTxQPMR</name>
          <displayName>ETH_MACTxQPMR</displayName>
          <description>The transmit queue priority mapping 0
