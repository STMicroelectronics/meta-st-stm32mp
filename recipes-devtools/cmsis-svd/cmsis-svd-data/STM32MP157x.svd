							<bitOffset>0</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>LPCFG</name>
							<description>LPCFG</description>
							<bitOffset>1</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
