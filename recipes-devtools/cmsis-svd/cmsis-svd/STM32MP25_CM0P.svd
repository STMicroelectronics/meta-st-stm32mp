                  <description>SPI mode is selected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>I2S/PCM mode is selected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
