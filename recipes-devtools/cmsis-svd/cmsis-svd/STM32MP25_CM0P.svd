        </register>
        <register>
          <name>RIFSC_RIMC_CR</name>
          <displayName>RIFSC_RIMC_CR</displayName>
          <description>RIFSC RIMC master configuration register</description>
          <addressOffset>0xC00</addressOffset>
          <size>0x20</size>
          <access>read-writeOnce</access>
          <resetValue>0x00008710</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GLOCK</name>
              <description>Global lock
This bit is used to lock the configuration of RIFSC RIMC registers until next reset. This bit is cleared by default and, once set, it cannot be reset until global RIFSC reset.
Note: Secure privileged write access only. Write only by debug domain and trusted domain CIDs, as defined in this register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>RIFSC RIMC registers are writable.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>All writes to RIFSC RIMC registers are ignored.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUCDONE</name>
              <description>Wake-up CPU done
Setting this bit deactivates the wake-up CPU mechanism described in Section5.2: Resource isolation framework (RIF). Reading this bit always returns zero.
Note: Secure privileged write access only. Write only by debug domain and trusted domain CIDs, as defined in this register (including this bit).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>When WUCEN = 1 in RIFSC_RIMC_SR, the trusted domain CID information is fixed to0x2 (wake-up CPU), else it is defined in this register.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Setting this bit clears WUCEN after few cycles. Once WUCEN =0, the trusted domain CID information is defined in this register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TDCID</name>
              <description>Trusted domain compartment ID
Master with this compartment ID runs the application with the highest level of trust. TDCID[2:0] value is distributed in all the device. This bit field is write once (subsequent writes are ignored).
Note: Secure privileged write access only. Write only by debug domain and trusted domain CIDs, as defined in this register.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-writeOnce</access>
            </field>
            <field>
              <name>DAPCID</name>
              <description>Debug access port compartment ID
This bit field defines the CID of the DAP when GDPEN is set in RIFSC_RIMC_SR. 
When DAPCID[2:0] = 0x7, debugging tools have the highest level of debug access, if secure global debug profile is enabled in the BSEC peripheral.
When GDPEN = 0, DAPCID[2:0] can be written by trusted application (TDCID secure privileged). When GDPEN = 1, the DAP can also change this bit field regardless of the access type (secure, non-secure, privileged, or unprivileged).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DDEN</name>
              <description>Debug domain enable
This read-only bit gives the status on the debug domain feature availability on this device.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Debug domain not available</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Debug domain available</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RIFSC_RIMC_SR</name>
          <displayName>RIFSC_RIMC_SR</displayName>
          <description>RIFSC RIMC master status register</description>
          <addressOffset>0xC04</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GDPEN</name>
              <description>Global debug profile enable
This read-only bit is set when the global-debug profile is activated in the device (CPU and MCU debugging allowed).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Global-debug profile (CPU + MCU) is not activated.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Global-debug profile (CPU + MCU) is activated.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WUCEN</name>
              <description>Wake-up CPU enable
This read-only bit is set when the application properly initializes the wake-up CPU mechanism described in Section5.2: Resource isolation framework (RIF).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Wake-up CPU is disabled. The trusted domain CID value is driven by RIFSC_RIMC_CR.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Wake-up CPU is enabled. The trusted domain CID value is fixed to 0x2 until the application sets WUCDONE in RIFSC_RIMC_CR (in this case, WUCDONE is cleared after few cycles).</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RIFSC_RIMC_ATTR0</name>
          <displayName>RIFSC_RIMC_ATTR0</displayName>
          <description>RIFSC RIMC master attribute register 0</description>
          <addressOffset>0xC10</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CIDSEL</name>
              <description>CID selection</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Compartment ID of master x is driven by hardware value or by inheritance to associated RISUP. See master table in Section8.3 for details.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Compartment ID of master x is defined by MCID[2:0] in this register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCID</name>
              <description>Master CID
Value of the CID flag on the interconnect for this master, programmed by the trusted domain.
Valid only if indicated in RIF masters table in Section8.3. This bit field is not taken into account when CIDSEL = 0 in this register.
This bit field cannot be written with a value of 0x7 (write to MCID[2:0] is ignored).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSEC</name>
              <description>Master secure
Value of the secure flag on the interconnect for this master, programmed by the trusted domain.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>This master is non-secure.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>This master is secure.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MPRIV</name>
              <description>Master privileged
Value of the privileged flag on the interconnect for this master, programmed by the trusted domain.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>This master is unprivileged.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>This master is privileged.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
