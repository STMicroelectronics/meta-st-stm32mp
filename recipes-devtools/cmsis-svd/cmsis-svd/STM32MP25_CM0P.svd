                  <description>No guaranteed minimum low time</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>~ 1 ms guaranteed minimum low time (1 x 32 LSI cycles)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>~ 2 ms guaranteed minimum low time (2 x 32 LSI cycles)</description>
                  <value>0x2</value>
                </enumeratedValue>
