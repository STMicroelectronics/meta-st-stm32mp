              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>PWR_CPU_ON pin signals DStandby mode (PWR_CPU_ON=1 in DRun, DStop1/2/3, and=0 in DStandby) (pwr_cpu_on).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>PWR_CPU_ON pin signals DStandby and DStop2/3 modes (PWR_CPU_ON = 1 in DRun, DStop1, and=0 in DStop2/3 and DStandby) (pwr_cpu_onlp).</description>
                  <value>0x1</value>
                </enumeratedValue>
