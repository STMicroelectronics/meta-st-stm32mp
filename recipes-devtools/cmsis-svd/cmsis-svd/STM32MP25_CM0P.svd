        <register>
          <name>LPDMA_HWCFGR12</name>
          <displayName>LPDMA_HWCFGR12</displayName>
          <description>LPDMA hardware configuration 12 register</description>
          <addressOffset>0xFC4</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00001111</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>G_PER_CTRL0</name>
              <description>DMA transfer type for channel 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>no peripheral flow control mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>peripheral flow control mode allowed</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>G_PER_CTRL1</name>
              <description>DMA transfer type for channel 1</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>no peripheral flow control mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>peripheral flow control mode allowed</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>G_PER_CTRL2</name>
              <description>DMA transfer type for channel 2</description>
