    <peripheral>
      <name>IPCC2</name>
      <description>IPCC2 address block description</description>
      <groupName>IPCC2</groupName>
      <baseAddress>0x46250000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x3F4</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>IPCC2_RX</name>
        <description>Mailbox nonsec Rx Occupied  interrupt</description>
        <value>13</value>
      </interrupt>
      <interrupt>
        <name>IPCC2_TX</name>
        <description>Mailbox nonsec Tx Free interrupt</description>
        <value>14</value>
      </interrupt>
      <registers>
        <register>
          <name>IPCC2_HWCFGR</name>
          <displayName>IPCC2_HWCFGR</displayName>
          <description>IPCC hardware configuration register</description>
          <addressOffset>0x3F0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x03000304</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CHANNELS</name>
              <description>Number of channels per CPU supported by the IP, range 1 to 16</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SECCTRL</name>
              <description>security options, range 1 to 16.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No security</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Security</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPTBITS</name>
              <description>reserved for future use</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CIDWIDTH</name>
              <description>CID bit field width range 0 to 12.
1..12: CID filtering with CID bit field with 1..12
13..15: reserved</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No CID filtering</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
