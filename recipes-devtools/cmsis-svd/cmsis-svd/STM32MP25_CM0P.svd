              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RPIF60</name>
              <description>configurable event input 60 rising edge Pending bit.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RPIF61</name>
              <description>configurable event input 61 rising edge Pending bit.
When EXTI2_SECCFGR2.SEC61 is disabled, RPIF61 can be accessed with non-secure and secure access.
When EXTI2_SECCFGR2.SEC61 is enabled, RPIF61 can only be accessed with secure access. Non-secure write to this RPIF61 is discarded, non-secure read returns 0.
When EXTI2_PRIVCFGR2.PRIV61 is disabled, RPIF ca61 be accessed with unprivileged and privilege access.
When EXTI2_PRIVCFGR2.PRIV61 is enabled, RPIF61 can only be accessed with privilege access. Unprivileged write to this RPIF61 is discarded, unprivileged read returns 0.
When CID filtering is disabled in EXTI2_E61CIDCFGR this RPIF61 can be accessed by any processor CID.
When CID filtering is enabled in EXTI2_E61CIDCFGR this RPIF61 can only be accessed by the allowed processor CID. Dis allowed CID write to this RPIF61 is discarded and read returns 0.
This bit is set when the selected rising edge event or an EXTI2_SWIER Software trigger arrives on the configurable event line. This bit is cleared by writing a 1 into the bit.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No rising edge trigger request occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>selected rising edge trigger request occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
