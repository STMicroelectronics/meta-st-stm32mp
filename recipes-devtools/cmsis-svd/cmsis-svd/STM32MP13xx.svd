                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x19</name>
                    <description>Division ratio is 26</description>
                    <value>0x19</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1A</name>
                    <description>Division ratio is 27</description>
                    <value>0x1A</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x31</name>
                    <description>Division ratio is 50 (default after reset)</description>
                    <value>0x31</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0xC7</name>
                    <description>Division ratio is 200</description>
                    <value>0xC7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DIVM3</name>
                <description>Prescaler for PLL3
Set and cleared by software to configure the prescaler of the PLL3.
...</description>
                <bitOffset>16</bitOffset>
                <bitWidth>6</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>bypass</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>division by 2 (default after reset)</description>
