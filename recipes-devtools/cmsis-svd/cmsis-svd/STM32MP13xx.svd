This bit is a copy of the ADRDY bit in the corresponding ADC_ISR register.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>EOSMP_MST</name>
