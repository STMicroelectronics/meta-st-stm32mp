                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x5</name>
                    <description>RL = 7 / WL = 4</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x6</name>
                    <description>RL = 8 / WL = 4</description>
                    <value>0x6</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
          </fields>
        </register>		
		<register>
          <name>DDRPHYC_LPDDR3_MR2</name>
