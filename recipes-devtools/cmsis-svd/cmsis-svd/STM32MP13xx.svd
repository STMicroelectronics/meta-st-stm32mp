                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ETH2_REF_CLK_SEL</name>
                <description>Ethernet reference clock selection.
Set by software.
This bit is secure if ETH2 is set to secure in the ETZPC.</description>
                <bitOffset>25</bitOffset>
