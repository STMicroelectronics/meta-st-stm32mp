                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Writing '1' unfreeze the IWDG1 clock, reading '1' means that the IWDG1 clock is frozen</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FZ_IWDG2</name>
                <description>Unfreeze the IWDG2 clock
Cleared by the BOOTROM software, in order to unfreeze the IWDG2.</description>
