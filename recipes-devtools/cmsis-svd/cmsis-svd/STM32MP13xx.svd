	<peripheral>
        <name>TZC</name>
        <description>TZC</description>
		<groupName>TZC</groupName>
        <baseAddress>0x5C006000</baseAddress>
        <addressBlock>
          <offset>0x0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>
		<interrupt>
          <name>TZC_IT</name>
