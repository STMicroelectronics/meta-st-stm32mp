                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>means that the peripheral clocks are enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
