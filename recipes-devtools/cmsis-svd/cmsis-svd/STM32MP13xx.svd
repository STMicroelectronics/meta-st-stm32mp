                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>Two ADC instances implemented</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>Three ADCs instances implemented</description>
