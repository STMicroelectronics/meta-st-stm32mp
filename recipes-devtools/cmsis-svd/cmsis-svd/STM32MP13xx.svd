                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x8</name>
                    <description>8  Kbytes address offset</description>
                    <value>0x8</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
