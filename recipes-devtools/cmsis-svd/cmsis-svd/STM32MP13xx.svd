              <field>
                <name>WRITE_ISS_OVERRIDE</name>
                <description>override AMIB write issuing capability</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
