                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>64-bit bus</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x4</name>
                    <description>128-bit bus</description>
                    <value>0x4</value>
