                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>HASH1SECF</name>
                <description>HASH1 block secure status flag
This bit reflects the HASH1 block secure state, as configured via the corresponding DECPROT[1] field of the ETZPC register.</description>
                <bitOffset>5</bitOffset>
