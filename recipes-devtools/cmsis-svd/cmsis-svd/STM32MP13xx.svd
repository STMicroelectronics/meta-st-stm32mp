                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>One-stage pipeline</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OPBITS</name>
                <description>Number of option bits</description>
                <bitOffset>8</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
