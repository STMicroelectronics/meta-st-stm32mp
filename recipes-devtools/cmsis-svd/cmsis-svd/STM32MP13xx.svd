                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Event after two lines</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Event after four lines</description>
                  <value>0x2</value>
