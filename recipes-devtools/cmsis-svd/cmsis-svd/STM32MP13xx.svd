          <register>
            <name>RCC_AHB6SECSR</name>
            <displayName>RCC_AHB6SECSR</displayName>
            <description>This read register reflects at a bit level the secure state of each AHB6 securable peripheral,
as configured via the corresponding DECPROT[1] field of the ETZPC register.</description>
            <addressOffset>0x8dc</addressOffset>
