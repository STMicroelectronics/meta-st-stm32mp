                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>VSYNC active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EDM</name>
              <description>Extended data mode
</description>
              <bitOffset>10</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Interface captures 8-bit data on every pixel clock</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Interface captures 10-bit data on every pixel clock</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Interface captures 12-bit data on every pixel clock</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>Interface captures 14-bit data on every pixel clock</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4</name>
                  <description>Interface captures 16-bit data on every pixel clock</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENABLE</name>
              <description>Parallel interface enable
</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Parallel interface disabled to lower power consumption</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Parallel interface enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FORMAT</name>
              <description>Other values: data are captured and output as-is only through the data/dump pipeline (for example JPEG or byte input format).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x1E</name>
                  <description>YUV422</description>
                  <value>0x1E</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x22</name>
                  <description>RGB565</description>
                  <value>0x22</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x24</name>
                  <description>RGB888 (= YUV444)</description>
                  <value>0x24</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2A</name>
                  <description>RAW8</description>
                  <value>0x2A</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2B</name>
                  <description>RAW10</description>
                  <value>0x2B</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2C</name>
                  <description>RAW12</description>
                  <value>0x2C</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2D</name>
                  <description>RAW14</description>
                  <value>0x2D</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4A</name>
                  <description>monochrome 8-bit</description>
                  <value>0x4A</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4B</name>
                  <description>monochrome 10-bit</description>
                  <value>0x4B</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4C</name>
                  <description>monochrome 12-bit</description>
                  <value>0x4C</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4D</name>
                  <description>monochrome 14-bit</description>
                  <value>0x4D</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x5A</name>
                  <description>byte stream (JPEG, compressed video)</description>
                  <value>0x5A</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWAPCYCLES</name>
              <description>Swap data (cycle 0 vs.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Default</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Swap active: the data of cycle 1 is used before the data of cycle 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWAPBITS</name>
              <description>Swap LSB vs.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>As received</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Swapped MSB vs.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
