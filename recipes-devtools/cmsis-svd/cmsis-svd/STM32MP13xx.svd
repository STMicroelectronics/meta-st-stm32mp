                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>pll4_p_ck output is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DIVQEN</name>
                <description>PLL4 DIVQ divider output enable
Set and reset by software to enable the pll4_q_ck output of the PLL4.
Cleared by hardware when entering a Stop mode or Standby.
In order to save power, when the pll4_q_ck is not needed, DIVQEN must be set to '0'.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
