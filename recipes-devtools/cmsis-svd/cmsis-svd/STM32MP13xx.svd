                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>peripheral is secure</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RNG1SECF</name>
