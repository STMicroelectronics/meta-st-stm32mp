          <register>
            <name>OTG_DIEPINT4</name>
            <displayName>OTG_DIEPINT4</displayName>
            <description>OTG device IN endpoint 4 interrupt register</description>
            <addressOffset>0x988</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000080</resetValue>
