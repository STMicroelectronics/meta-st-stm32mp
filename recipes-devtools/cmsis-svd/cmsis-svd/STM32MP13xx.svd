                </enumeratedValues>
              </field>
              <field>
                <name>IFRGE</name>
                <description>PLL3 input frequency range
Written by software to select the proper reference frequency range used for PLL3.
x0: The PLL3 input (ref3_ck) clock range frequency is between 4 and 8 MHz (default after reset)
x1: The PLL3 input (ref3_ck) clock range frequency is between 8 and 16 MHz.
Note that if ref3_ck is equal to 8 MHz, it is recommended to set IFRGE = 'x1</description>
                <bitOffset>24</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
