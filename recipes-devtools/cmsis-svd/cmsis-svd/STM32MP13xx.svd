                <bitWidth>4</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>MUX1</name>
                <description>Select the HDP1 output among the 16 available signals</description>
                <bitOffset>4</bitOffset>
                <bitWidth>4</bitWidth>
