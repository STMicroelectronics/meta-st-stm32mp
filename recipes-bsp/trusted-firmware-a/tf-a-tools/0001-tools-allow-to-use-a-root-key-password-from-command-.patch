From e1950f9cc1640aa00877b8b87157fb80e2aefd71 Mon Sep 17 00:00:00 2001
From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Wed, 27 May 2026 16:04:22 +0200
Subject: [PATCH] tools: allow to use a root key password from command line

By defining the ROT_KEY_PWD, user is able to define the private
root key password. Useful for build system management.

Signed-off-by: Lionel Debieve <lionel.debieve@st.com>
Upstream-Status: Inappropriate [specific to ST boards]
---
 make_helpers/tbbr/tbbr_tools.mk |  2 ++
 tools/cert_create/include/key.h |  2 +-
 tools/cert_create/src/key.c     |  4 ++--
 tools/cert_create/src/main.c    | 13 +++++++++++--
 4 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/make_helpers/tbbr/tbbr_tools.mk b/make_helpers/tbbr/tbbr_tools.mk
index b989a6a496..a8b10f8fef 100644
--- a/make_helpers/tbbr/tbbr_tools.mk
+++ b/make_helpers/tbbr/tbbr_tools.mk
@@ -26,6 +26,7 @@
 #   ROT_KEY
 #   PROT_KEY
 #   PLAT_KEY
+#   ROT_KEY_PWD
 #   SWD_ROT_KEY
 #   CORE_SWD_KEY
 #   TRUSTED_WORLD_KEY
@@ -83,6 +84,7 @@ $(if ${ROT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${ROT_KEY},--rot-key)))
 $(if ${ROT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${ROT_KEY},--rot-key,FWU_)))
 $(if ${ROT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${ROT_KEY},--rot-key,BL2_)))
 $(if ${PROT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${PROT_KEY},--prot-key)))
+$(if ${ROT_KEY_PWD},$(eval $(call CERT_ADD_CMD_OPT,${ROT_KEY_PWD},--rot-key-pwd)))
 $(if ${PLAT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${PLAT_KEY},--plat-key)))
 $(if ${SWD_ROT_KEY},$(eval $(call CERT_ADD_CMD_OPT,${SWD_ROT_KEY},--swd-rot-key)))
 $(if ${CORE_SWD_KEY},$(eval $(call CERT_ADD_CMD_OPT,${CORE_SWD_KEY},--core-swd-key)))
diff --git a/tools/cert_create/include/key.h b/tools/cert_create/include/key.h
index 83a7b18893..0743c60e94 100644
--- a/tools/cert_create/include/key.h
+++ b/tools/cert_create/include/key.h
@@ -74,7 +74,7 @@ cert_key_t *key_get_by_opt(const char *opt);
 int key_new(cert_key_t *key);
 #endif
 int key_create(cert_key_t *key, int type, int key_bits);
-unsigned int key_load(cert_key_t *key);
+unsigned int key_load(cert_key_t *key, char *rot_key_pwd);
 int key_store(cert_key_t *key);
 void key_cleanup(void);
 
diff --git a/tools/cert_create/src/key.c b/tools/cert_create/src/key.c
index 4fc0addd68..b2a52e5892 100644
--- a/tools/cert_create/src/key.c
+++ b/tools/cert_create/src/key.c
@@ -251,7 +251,7 @@ err:
 
 }
 
-unsigned int key_load(cert_key_t *key)
+unsigned int key_load(cert_key_t *key, char *rot_key_pwd)
 {
 	if (key->fn == NULL) {
 		VERBOSE("Key not specified\n");
@@ -269,7 +269,7 @@ unsigned int key_load(cert_key_t *key)
 			return KEY_ERR_OPEN;
 		}
 
-		key->key = PEM_read_PrivateKey(fp, NULL, NULL, NULL);
+		key->key = PEM_read_PrivateKey(fp, NULL, NULL, rot_key_pwd);
 		fclose(fp);
 	}
 
diff --git a/tools/cert_create/src/main.c b/tools/cert_create/src/main.c
index aa21206c02..2f58333eb5 100644
--- a/tools/cert_create/src/main.c
+++ b/tools/cert_create/src/main.c
@@ -288,6 +288,10 @@ static const cmd_opt_t common_cmd_opt[] = {
 		{ "print-cert", no_argument, NULL, 'p' },
 		"Print the certificates in the standard output"
 	}
+	,{
+		{ "rot-key-pwd", required_argument, NULL, 'r' },
+		"Password for the root key"
+	},
 };
 
 int main(int argc, char *argv[])
@@ -306,6 +310,7 @@ int main(int argc, char *argv[])
 	unsigned char md[SHA512_DIGEST_LENGTH];
 	unsigned int  md_len;
 	const EVP_MD *md_info;
+	char *rot_key_pw = NULL;
 
 	NOTICE("CoT Generation Tool: %s\n", build_msg);
 	NOTICE("Target platform: %s\n", platform_msg);
@@ -343,7 +348,7 @@ int main(int argc, char *argv[])
 
 	while (1) {
 		/* getopt_long stores the option index here. */
-		c = getopt_long(argc, argv, "a:b:hknps:", cmd_opt, &opt_idx);
+		c = getopt_long(argc, argv, "a:b:hknps:r:", cmd_opt, &opt_idx);
 
 		/* Detect the end of the options. */
 		if (c == -1) {
@@ -377,6 +382,10 @@ int main(int argc, char *argv[])
 		case 'p':
 			print_cert = 1;
 			break;
+		case 'r':
+			rot_key_pw = malloc(sizeof(char) * strlen(optarg) + 1);
+			strncpy(rot_key_pw, optarg, strlen(optarg) + 1);
+			break;
 		case 's':
 			hash_alg = get_hash_alg(optarg);
 			if (hash_alg < 0) {
@@ -437,7 +446,7 @@ int main(int argc, char *argv[])
 #endif
 
 		/* First try to load the key from disk */
-		err_code = key_load(&keys[i]);
+		err_code = key_load(&keys[i], rot_key_pw);
 		if (err_code == KEY_ERR_NONE) {
 			/* Key loaded successfully */
 			continue;
-- 
2.43.0

