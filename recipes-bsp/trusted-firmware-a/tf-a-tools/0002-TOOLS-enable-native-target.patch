From cfc1bc835d7a98f0e60da45ce26a72cf3174bc9e Mon Sep 17 00:00:00 2001
From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Thu, 11 Jun 2026 09:43:08 +0200
Subject: [PATCH 2/2] TOOLS: enable native target

Signed-off-by: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Upstream-Status: Inappropriate [specific to ST boards]

---
 tools/cert_create/Makefile | 3 +++
 tools/encrypt_fw/Makefile  | 3 +++
 tools/fiptool/Makefile     | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/tools/cert_create/Makefile b/tools/cert_create/Makefile
index cd676f0451..f85774bf73 100644
--- a/tools/cert_create/Makefile
+++ b/tools/cert_create/Makefile
@@ -73,6 +73,9 @@ CRTTOOL_INCLUDE_DIRS += ./include ${PLAT_INCLUDE} ${OPENSSL_DIR}/include
 CRTTOOL_LDFLAGS += -L ${OPENSSL_DIR}/lib -L ${OPENSSL_DIR}
 CRTTOOL_LDFLAGS += -lssl -lcrypto
 
+CRTTOOL_CFLAGS += ${TOOLS_CFLAGS}
+CRTTOOL_LDFLAGS += ${TOOLS_LDFLAGS}
+
 .PHONY: all clean realclean --openssl
 
 $(eval $(call MAKE_TOOL,$(BUILD_PLAT)/tools,cert_create,CRTTOOL))
diff --git a/tools/encrypt_fw/Makefile b/tools/encrypt_fw/Makefile
index 9552aa3409..08f04b713d 100644
--- a/tools/encrypt_fw/Makefile
+++ b/tools/encrypt_fw/Makefile
@@ -55,6 +55,9 @@ ENCTOOL_INCLUDE_DIRS := ./include ../../include/tools_share ${OPENSSL_DIR}/inclu
 ENCTOOL_LDFLAGS := -L${OPENSSL_DIR}/lib -L${OPENSSL_DIR}
 ENCTOOL_LDFLAGS += -lssl -lcrypto
 
+ENCTOOL_CFLAGS += ${TOOLS_CFLAGS}
+ENCTOOL_LDFLAGS += ${TOOLS_LDFLAGS}
+
 .PHONY: all clean realclean --openssl
 
 all: --openssl
diff --git a/tools/fiptool/Makefile b/tools/fiptool/Makefile
index 6deac9d0f1..8dfac0dcdc 100644
--- a/tools/fiptool/Makefile
+++ b/tools/fiptool/Makefile
@@ -49,6 +49,9 @@ FIPTOOL_LDFLAGS := -L${OPENSSL_DIR}/lib -L${OPENSSL_DIR} -lcrypto
 FIPTOOL_INCLUDE_DIRS += ${OPENSSL_DIR}/include
 endif # STATIC
 
+FIPTOOL_CFLAGS += ${TOOLS_CFLAGS}
+FIPTOOL_LDFLAGS += ${TOOLS_LDFLAGS}
+
 ifneq (${PLAT},)
 TF_PLATFORM_ROOT	:=	../../plat/
 include ${MAKE_HELPERS_DIRECTORY}plat_helpers.mk
-- 
2.43.0

