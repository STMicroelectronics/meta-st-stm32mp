+		mmio_write_32(stm32mp2_clock_data.base + RCC_FINDIV5CFGR, saved_findiv5cfgr);
+		if (wait_findivsr(5) != 0) {
+			panic();
+		}
+		mmio_write_32(stm32mp2_clock_data.base + RCC_XBAR5CFGR, saved_xbar5cfgr);
+		if (wait_xbar_sts(5) != 0) {
