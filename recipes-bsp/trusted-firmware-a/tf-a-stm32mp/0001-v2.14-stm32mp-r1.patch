+		rc = plat_get_rotpk_info(NULL, &pk_ptr, &len, &flags);
+		if ((rc != -EINVAL) && ((flags & ROTPK_NOT_DEPLOYED) == 0)) {
+			auth = true;
+		}
+	} else {
+		auth = true;
+	}
+end:
+	NOTICE("Bootrom authentication %s\n", auth ? "succeeded" : "failed");
+
+#endif /* TRUSTED_BOARD_BOOT && DYN_DISABLE_AUTH && !STM32MP21 */
+}
 
