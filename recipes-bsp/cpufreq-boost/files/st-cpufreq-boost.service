[Unit]
Description=Service for enabling CPU Boost
ConditionPathExists=/sys/devices/system/cpu/cpufreq/boost
ConditionPathIsReadWrite=/sys/devices/system/cpu/cpufreq/boost
After=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=bash -c 'echo 1 > /sys/devices/system/cpu/cpufreq/boost'
ExecStop=bash -c 'echo 0 > /sys/devices/system/cpu/cpufreq/boost'
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
