Subject: [PATCH] silent_mode

---
Upstream-Status: Inappropriate [specific to ST boards]

 include/configs/stm32mp13_st_common.h | 1 +
 include/configs/stm32mp15_st_common.h | 1 +
 include/configs/stm32mp21_st_common.h | 1 +
 include/configs/stm32mp23_st_common.h | 1 +
 include/configs/stm32mp25_st_common.h | 1 +
 5 files changed, 5 insertions(+)

diff --git a/include/configs/stm32mp13_st_common.h b/include/configs/stm32mp13_st_common.h
index 8e075cdd248..b35423b0819 100644
--- a/include/configs/stm32mp13_st_common.h
+++ b/include/configs/stm32mp13_st_common.h
@@ -18,6 +18,7 @@
 #endif
 
 #define STM32MP_BOARD_EXTRA_ENV \
+	"silent=1\0" \
 	"usb_pgood_delay=2000\0" \
 	"console=ttySTM0\0"
 
diff --git a/include/configs/stm32mp15_st_common.h b/include/configs/stm32mp15_st_common.h
index 57f78697813..06f33e0fdc1 100644
