From 4a29e0c69fab43dfb7bf606a4a76f5b752fd50eb Mon Sep 17 00:00:00 2001
From: Dario Binacchi <dario.binacchi@amarulasolutions.com>
Date: Sun, 10 May 2026 10:43:07 +0200
Subject: [PATCH] configs: stm32mp15: enable A/B support with multiple FWU
 images

Enable full A/B redundancy support for STM32MP15 by increasing the
number of FWU images per bank to 3.

This change is required for A/B redundancy systems where the FWU
metadata contains information for three images per bank (typically
FIP, boot, and root partitions).

In U-Boot, the FWU metadata loading logic enforces a strict check
between the number of images defined in the configuration and those
stored in the metadata structure. Increasing this value ensures
compatibility with the new partition layout and prevents metadata
loading errors.

Signed-off-by: Dario Binacchi <dario.binacchi@amarulasolutions.com>
Upstream-Status: Pending [specific to ST boards]
---
 configs/stm32mp15_basic_defconfig | 2 +-
 configs/stm32mp15_defconfig       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/configs/stm32mp15_basic_defconfig b/configs/stm32mp15_basic_defconfig
index 7a4be381e66b..98e41467efad 100644
--- a/configs/stm32mp15_basic_defconfig
+++ b/configs/stm32mp15_basic_defconfig
@@ -19,7 +19,7 @@ CONFIG_SPL_SPI_FLASH_SUPPORT=y
 CONFIG_SPL_SPI=y
 # CONFIG_ARMV7_VIRT is not set
 CONFIG_SYS_LOAD_ADDR=0xc2000000
-CONFIG_FWU_NUM_IMAGES_PER_BANK=1
+CONFIG_FWU_NUM_IMAGES_PER_BANK=3
 CONFIG_OF_BOARD_FIXUP=y
 CONFIG_SYS_MEMTEST_START=0xc0000000
 CONFIG_SYS_MEMTEST_END=0xc4000000
diff --git a/configs/stm32mp15_defconfig b/configs/stm32mp15_defconfig
index 5821cb3d2359..f5c225e65f9c 100644
--- a/configs/stm32mp15_defconfig
+++ b/configs/stm32mp15_defconfig
@@ -13,7 +13,7 @@ CONFIG_ENV_OFFSET_REDUND=0x940000
 CONFIG_CMD_STM32PROG=y
 # CONFIG_ARMV7_NONSEC is not set
 CONFIG_SYS_LOAD_ADDR=0xc2000000
-CONFIG_FWU_NUM_IMAGES_PER_BANK=1
+CONFIG_FWU_NUM_IMAGES_PER_BANK=3
 CONFIG_OF_BOARD_FIXUP=y
 CONFIG_SYS_MEMTEST_START=0xc0000000
 CONFIG_SYS_MEMTEST_END=0xc4000000
-- 
