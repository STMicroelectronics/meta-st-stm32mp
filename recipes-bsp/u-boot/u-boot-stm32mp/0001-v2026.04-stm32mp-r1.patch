+U_BOOT_DRIVER(stm32_usb2phy) = {
+	.name = "stm32-usb2phy",
+	.id = UCLASS_PHY,
+	.bind = stm32_usb2phy_bind,
+	.of_match = stm32_usb2phy_of_match,
