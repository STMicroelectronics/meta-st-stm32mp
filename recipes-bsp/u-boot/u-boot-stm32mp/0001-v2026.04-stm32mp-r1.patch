+	struct udevice *clk_dev;
+	int ret;
+
+	ret = uclass_get_device_by_name(UCLASS_CLK, "txbyteclk", &clk_dev);
+	if (ret < 0) {
+		dev_err(dev, "Fail to get txbyte clock device: %d\n", ret);
+		return ret;
+	}
+
+	txbyte_clk = dev_get_priv(clk_dev);
+
+	dev_dbg(dev, "Initialize DSI physical layer\n");
 
 	/* Select video mode by resetting DSIM bit */
 	dsi_clear(plat->base, DSI_WCFGR, WCFGR_DSIM);
 
 	/* Select the color coding */
 	dsi_update_bits(plat->base, DSI_WCFGR, WCFGR_COLMUX,
-			dsi_color_from_mipi(format) << 1);
+			dsi_color_from_mipi(priv->format) << 1);
 
-	*lane_mbps = pll_out_khz / 1000;
+	dsi_write(plat->base, DSI_PCTLR, 0x00);
+
+	/* clear the pll shadow regs */
+	dsi_set(plat->base, DSI_WRPCR2, WRPCR2_CLR);
+	mdelay(1);
+
+	dsi_clear(plat->base, DSI_WRPCR2, WRPCR2_CLR);
+	mdelay(1);
+
+	/* set testclr = 1 */
+	dsi_set(plat->base, DSI_PTCR0, PTCR0_TRSEN);
+	mdelay(1);
+
+	dsi_clear(plat->base, DSI_PTCR0, PTCR0_TRSEN);
+	mdelay(1);
+
+	ret = clk_set_rate(&txbyte_clk->clkp, priv->lane_mbps * 1000 * 1000);
+	if (ret < 0) {
+		dev_err(dev, "Set Txbyte clock error %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_enable(&txbyte_clk->clkp);
+	if (ret) {
+		dev_err(dev, "Txbyte clock enable error %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
