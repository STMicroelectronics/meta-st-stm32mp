+#define S26_CMD_READ_VCR1	0xC7
+#define S26_CMD_READ_VCR2	0xC9
+#define S26_CFR1V_UNIFORM	BIT(9)
+#define S26_CFR1V_TP4KBS	BIT(8)
+#define S26_CFR2V_SP4KBS	BIT(2)
