+static void stm32_ospi_dlyb_stop(struct udevice *dev)
+{
+	struct stm32_ospi_plat *plat = dev_get_plat(dev);
+
+	/* disable delay block */
+	regmap_write(plat->regmap,
+		     plat->dlyb_base + SYSCFG_DLYBOS_CR,
+		     0x0);
+}
