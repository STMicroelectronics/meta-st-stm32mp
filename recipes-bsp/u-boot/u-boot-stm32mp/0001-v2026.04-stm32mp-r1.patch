+static int stm32_usb2phy_clk48_enable(struct clk *clk)
+{
+	struct stm32_usb2phy *usb2phy;
+
+	if (clk_get_id(clk) != CK_USB2PHY_48M_ID)
+		return 0;
+
+	/* ck_usb2phy_48m is generated by usb2phy PLL */
+	usb2phy = dev_get_priv(clk->dev->parent->parent);
+
+	return stm32_usb2phy_clk_enable(usb2phy);
+}
+
+static int stm32_usb2phy_clk48_disable(struct clk *clk)
+{
+	struct stm32_usb2phy *usb2phy;
+
+	if (clk_get_id(clk) != CK_USB2PHY_48M_ID)
+		return 0;
+
+	usb2phy = dev_get_priv(clk->dev->parent->parent);
+
+	return stm32_usb2phy_clk_disable(usb2phy);
+}
+
+static unsigned long stm32_usb2phy_clk48_get_rate(struct clk *clk)
+{
+	return USB2PHY_CLK48_FREQ;
+}
+
+static const struct clk_ops stm32_usb2phy_clk48_ops = {
+	.enable = stm32_usb2phy_clk48_enable,
+	.disable = stm32_usb2phy_clk48_disable,
+	.get_rate = stm32_usb2phy_clk48_get_rate,
+};
+
+int usb2phy_clk48_register(struct udevice *dev, struct clk *clk, const char * name,
+			   const char * parent_name, ulong id)
+{
+	int length;
+	char *buf;
+	int ret;
+
+	length = snprintf(NULL, 0, "%s.%s", dev->name, name) + 1;
+	buf = malloc(length);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	snprintf(buf, length, "%s.%s", dev->name, name);
+	ret = clk_register(clk, UBOOT_DM_CLK_STM32_USB2PHY, buf, parent_name);
+	if (ret)
+		goto err;
+
+	dev_clk_dm(dev, id, clk);
+
+	return ret;
+
+err:
+	free(clk);
+	return ret;
+}
+
+int usb2phy_clk48_probe(struct udevice *dev)
+{
+	struct clk *clk;
+	int ret;
+
+	/* Register children clock for CCF */
+	if (device_get_uclass_id(dev->parent) != UCLASS_PHY)
+		return 0;
+
+	/* Register the clocks managed by the driver */
+	clk = kzalloc(3 * sizeof(*clk), GFP_KERNEL);
+	if (!clk)
+		ret = -ENOMEM;
+
+	/* Internal clock, parent of the exposed clocks */
+	ret = usb2phy_clk48_register(dev, &clk[2], "48m", dev->name, CK_USB2PHY_48M_ID);
+	if (ret)
+		goto err;
+
+	/* Clock exposed for each port with device tree */
+	ret = usb2phy_clk48_register(dev, &clk[0], "0", clk[2].dev->name, 0);
+	if (ret)
+		goto err;
+
+	ret = usb2phy_clk48_register(dev, &clk[1], "1", clk[2].dev->name, 1);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	free(clk);
+	return ret;
+}
+
+U_BOOT_DRIVER(stm32_usb_phyc_clk) = {
+	.name = UBOOT_DM_CLK_STM32_USB2PHY,
+	.id = UCLASS_CLK,
+	.ops = &stm32_usb2phy_clk48_ops,
+	.probe = &usb2phy_clk48_probe,
+};
